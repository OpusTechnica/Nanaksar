---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import SignaturesShowcase from '../components/SignaturesShowcase';
import BestsellersShowcase from '../components/BestsellersShowcase';
import OutletsDirectory from '../components/OutletsDirectory.astro';
import ReviewsSection from '../components/ReviewsSection.astro';
import HeritageStory from '../components/HeritageStory.astro';
import PlatformsSection from '../components/PlatformsSection.astro';
import BookTableSection from '../components/BookTableSection.astro';
import Footer from '../components/Footer.astro';
import Threshold from '../components/Threshold.astro';

// Single-file kill switch for Homepage Overlay (Enabled for live entrance gate)
const THRESHOLD_ENABLED = true;
---

<Layout>
  {THRESHOLD_ENABLED && <Threshold mode="overlay" />}

  <!-- Hero & 4-Pillar Verified Trust Stats Bar -->
  <Hero />

  <!-- ZONE 1: The Daytime Feast & Menu Discovery (#F7F4EB Warm Makkhan Cream) -->
  <!-- 1. Crown Signatures (6 Flagship Dishes in 3x2 Grid) -->
  <SignaturesShowcase client:visible />

  <!-- 2. Top Bestsellers & Highway Combos -->
  <BestsellersShowcase client:visible />

  <!-- 3. Official Available Delivery & Discovery Platforms (Warm Cream) -->
  <PlatformsSection />

  <!-- 4. Loved Across Indore (Verified Reviews) -->
  <ReviewsSection />

  <!-- ZONE 2: The Highway Hearth & Destinations (#0F0F0F Deep Obsidian) -->
  <!-- 5. Heritage Highway Story & 24-Hour Bhatti Craft (Samvayra Bento) -->
  <HeritageStory />

  <!-- 6. Five Indore Outlets Directory & Booking Hub -->
  <OutletsDirectory />

  <!-- 7. Premium Family Table Reservation Hub (Dark Apron) -->
  <BookTableSection />

  <!-- Grounded Brand Footer -->
  <Footer />
</Layout>
