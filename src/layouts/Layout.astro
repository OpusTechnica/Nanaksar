---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header';
import CartDrawer from '../components/CartDrawer';
import TableReservationModal from '../components/TableReservationModal';
import StructuredData from '../components/StructuredData.astro';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  preloadHero?: boolean;
}

const {
  title = "Nanaksar Dhaba Indore | Ghar Jaisa Swad. Seva Wala Pyar. | Est. 1980",
  description = "Nanaksar Dhaba Indore - Roots since 1980, first highway hearth established 2005. Famous 24-Hour Slow-Cooked Dal Makhani, Clay-Oven Chur Chur Naan & 100% Pure Vegetarian North Indian Cuisine across 5 Indore Outlets.",
  noindex = false,
  preloadHero = true,
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />

    <!-- Zero-FOUC Smart Welcome Gate Script (Synchronous Head Guard) -->
    <script is:inline>
      (function () {
        try {
          var entered = sessionStorage.getItem('nanaksar_entered') === 'true';
          var isWelcome = window.location.pathname === '/welcome';
          var isHome = window.location.pathname === '/' || window.location.pathname === '';
          if (isWelcome || (isHome && !entered)) {
            document.documentElement.classList.add('has-welcome-gate');
          }
        } catch (e) {}
      })();
    </script>
    <style is:inline>
      /* Ensure Header stays completely invisible during welcome gate */
      html.has-welcome-gate header {
        opacity: 0 !important;
        pointer-events: none !important;
        visibility: hidden !important;
      }
      header {
        transition: opacity 600ms cubic-bezier(0.16, 1, 0.3, 1), visibility 600ms ease;
      }
      /* Hard-prevent returning visitors from ever rendering the threshold element */
      html:not(.has-welcome-gate) #nanaksar-threshold:not([data-mode="page"]) {
        display: none !important;
      }
    </style>

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" type="image/png" href="/assets/favicon-32x32.png" />
    <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />

    {preloadHero && (
      <>
        <!-- Responsive Hero Preload for Instant 0ms LCP -->
        <link rel="preload" as="image" href="/assets/hero-desktop.webp" type="image/webp" media="(min-width: 640px)" />
        <link rel="preload" as="image" href="/assets/hero-mobile.webp" type="image/webp" media="(max-width: 639px)" />
      </>
    )}

    <!-- Preload Brand Assets for Zero-CLS Threshold Entrance -->
    <link rel="preload" as="image" href="/assets/Logo.webp" type="image/webp" />
    <link rel="preload" as="image" href="/assets/Brand_Name.webp" type="image/webp" />

    <!-- Google Fonts Preconnect & Preload (Option A: Royal Highway Heritage) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Cormorant+Garamond:ital,wght@1,600&family=JetBrains+Mono:wght@600&family=Noto+Serif+Devanagari:wght@600;700&family=Plus+Jakarta+Sans:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,600&display=swap"
      rel="stylesheet"
    />

    <!-- Preload the single shared icon sprite (one cached request, all sections) -->
    <link rel="preload" as="image" href="/assets/icons.svg" />

    <!-- Open Graph Metadata (Crawler-Safe 1200x630 JPEG with Absolute URL) -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://nanaksardhaba.com/assets/og-cover.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:type" content="restaurant" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://nanaksardhaba.com/assets/og-cover.jpg" />
    <meta name="theme-color" content="#0F0F0F" />

    <!-- Astro SPA View Transitions Router with Instant Swap -->
    <ClientRouter fallback="swap" />

    <!-- Schema.org JSON-LD for AI Search Crawlers -->
    <StructuredData />
  </head>
  <body class="bg-[#0F0F0F] text-[#F7F4EB] font-sans antialiased overflow-x-clip selection:bg-[#D01B1B] selection:text-white">
    <!-- Instant Top Navigation Progress Bar (0ms tactile feedback) -->
    <div
      id="nav-progress-bar"
      class="fixed top-0 left-0 h-[2.5px] bg-[#D01B1B] z-[9999] pointer-events-none transition-all duration-200 opacity-0 w-0"
      aria-hidden="true"
    ></div>
    <script is:inline>
      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('nav-progress-bar');
        if (bar) {
          bar.style.transition = 'width 0.25s ease-out, opacity 0.1s ease';
          bar.style.opacity = '1';
          bar.style.width = '70%';
        }
      });
      document.addEventListener('astro:page-load', () => {
        const bar = document.getElementById('nav-progress-bar');
        if (bar) {
          bar.style.width = '100%';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              bar.style.width = '0';
            }, 150);
          }, 100);
        }
      });
    </script>

    <!-- Global Sticky Navigation Header (Persisted across pages) -->
    <Header client:load transition:persist />

    <!-- Main Page Content Slot -->
    <main>
      <slot />
    </main>

    <!-- Global Cart Drawer Island (Persisted state, hydrated on idle) -->
    <CartDrawer client:idle transition:persist />

    <!-- Global Table Reservation Modal Island (Persisted state) -->
    <TableReservationModal client:idle transition:persist />
  </body>
</html>
