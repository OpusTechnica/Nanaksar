---
import HeroStatsBar from './HeroStatsBar.astro';
import { BRAND_INFO } from '../data/restaurantData';
import heroBg from '../assets/BB.png';
---

<section id="home" class="relative w-full min-h-[100dvh] bg-[#0F0F0F] text-white flex flex-col justify-between overflow-hidden pt-20 sm:pt-24">
  
  <!-- Hero Background Image & High-Contrast Gradient Scrim -->
  <div class="absolute inset-0 z-0">
    <img
      src={heroBg.src}
      alt="Nanaksar Dal Makhani and Authentic Thali Feast"
      class="w-full h-full object-cover object-center sm:object-right select-none"
      loading="eager"
      fetchpriority="high"
    />
    <div class="absolute inset-0 hero-scrim"></div>
  </div>

  <!-- Hero Main Content -->
  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10 pb-4 sm:pb-6 w-full my-auto flex flex-col justify-between">
    <div class="max-w-2xl lg:max-w-3xl flex flex-col items-start text-left">
      
      <!-- VisualPatch 1: Solid Obsidian Eyebrow Badge (Zero Blur) -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#141414] border border-[#E4A834]/50 mb-2.5 sm:mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#E4A834]"></span>
        <span class="font-display text-[10px] sm:text-xs font-bold tracking-[0.25em] text-[#E4A834] uppercase antialiased">
          ESTD. {BRAND_INFO.established} • {BRAND_INFO.yearsOfHeritage} YEARS OF HERITAGE
        </span>
      </div>

      <!-- Main Headline: "GOOD FOOD FOR GOOD PEOPLE" -->
      <h1 class="font-display text-4xl xs:text-5xl sm:text-6xl lg:text-[5.25rem] font-bold uppercase tracking-tight leading-[0.92] sm:leading-[0.88] mb-3">
        <span class="text-[#F7F4EB] block">GOOD FOOD.</span>
        <span class="text-[#D01B1B] block">FOR GOOD PEOPLE.</span>
      </h1>

      <!-- Decorative Sub-Badge with Bhatti Flame Ember Icons -->
      <div class="flex items-center gap-2 sm:gap-2.5 my-1.5 sm:my-2 text-[#E4A834]">
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.6-6.3 4.6 2.3-7.1-6-4.5h7.6z"/></svg>
        <span class="font-display text-xs sm:text-sm font-semibold tracking-[0.20em] uppercase text-[#E4A834]">
          100% SHUDDH PURE VEGETARIAN • PURE DESI GHEE
        </span>
        <svg class="w-3.5 h-3.5 fill-current shrink-0" viewBox="0 0 24 24"><path d="M12 2l2.4 7.4H22l-6 4.5 2.3 7.1-6.3-4.6-6.3 4.6 2.3-7.1-6-4.5h7.6z"/></svg>
      </div>

      <!-- Narrative Copy (Option A: Editorial Heritage Serif) -->
      <p class="font-editorial italic text-base sm:text-lg md:text-xl text-[#F7F4EB]/95 leading-relaxed mb-4 sm:mb-6 max-w-2xl">
        Rooted in Indore since 1980, Nanaksar brings generations of vegetarian tradition to the table. From slow-cooked <span class="text-[#E4A834] font-semibold">Dal Makhani</span> to hand-crushed <span class="text-[#E4A834] font-semibold">Chur Chur Naan</span>, every plate carries the spirit of pure sewa.
      </p>

      <!-- Dual Action CTAs (Solid Crisp States, Zero Diffuse Glows) -->
      <div class="flex flex-col xs:flex-row items-stretch xs:items-center gap-3 w-full xs:w-auto mb-4 sm:mb-6">
        <a
          href="/all-categories"
          class="flex items-center justify-center gap-2 bg-[#D01B1B] hover:bg-[#B81414] text-white px-7 sm:px-8 py-3 rounded-xl font-display text-xs sm:text-sm font-bold tracking-wider uppercase transition hover:scale-[1.02] min-h-[44px] focus:outline-none focus:ring-1 focus:ring-[#E4A834]"
        >
          <span>EXPLORE MENU</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>

        <a
          href="/outlets"
          class="flex items-center justify-center gap-2 bg-[#141414]/80 backdrop-blur-sm border border-[#E4A834] text-[#E4A834] hover:bg-[#E4A834] hover:text-[#0F0F0F] px-7 sm:px-8 py-3 rounded-xl font-display text-xs sm:text-sm font-bold tracking-wider uppercase transition-colors duration-200 min-h-[44px] focus:outline-none focus:ring-1 focus:ring-[#E4A834]"
        >
          <span>FIND AN OUTLET</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>

    </div>

    <!-- Integrated Premium Glassmorphic 4-Pillar Trust Stats Bar -->
    <HeroStatsBar />

  </div>

</section>
