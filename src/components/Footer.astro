---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<footer class="bg-[#0A0A0A] text-white pt-12 sm:pt-16 pb-10 sm:pb-12 border-t border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Header Ribbon: Brand Seal + Dietary Guarantee & Kinetic Action Button -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6 pb-8 sm:pb-10 border-b border-white/10">
      
      <!-- Brand Lockup -->
      <a href="/" class="flex items-center gap-3 sm:gap-3.5 group focus:outline-none focus:ring-1 focus:ring-[#E4A834] rounded-lg p-0.5 shrink-0 inline-flex">
        <img
          src="/assets/Logo.png"
          alt="Nanaksar Dhaba Seal"
          class="h-11 w-11 sm:h-13 sm:w-13 object-contain group-hover:scale-105 transition-transform shrink-0"
        />
        <div class="flex flex-col justify-center">
          <img
            src="/assets/Brand_Name.png"
            alt="Nanaksar Dhaba"
            class="h-7 sm:h-9 md:h-10 w-auto object-contain"
          />
          <span class="text-[9px] sm:text-[10px] md:text-[11px] font-display font-semibold tracking-widest text-[#E4A834] uppercase -mt-0.5">
            ESTD. {BRAND_INFO.established} • INDORE, M.P.
          </span>
        </div>
      </a>

      <!-- Dietary Guarantee & Kinetic Staggered Action Button -->
      <div class="flex flex-wrap items-center gap-4 sm:gap-6">
        <div class="flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-white/80">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
          <span>100% SHUDDH PURE VEG</span>
        </div>

        <!-- Premium Kinetic Staggered Action Button -->
        <a href="/all-categories" class="kinetic-footer-btn" aria-label="Explore Menu">
          <div class="text-wrap">
            <span>M</span>
            <span>E</span>
            <span>N</span>
            <span>U</span>
          </div>
          <div class="clone-wrap">
            <span>M</span>
            <span>E</span>
            <span>N</span>
            <span>U</span>
          </div>
          <svg stroke-width="2.5" stroke="currentColor" viewBox="0 0 24 24" fill="none">
            <path d="M14 5l7 7m0 0l-7 7m7-7H3" stroke-linejoin="round" stroke-linecap="round"></path>
          </svg>
        </a>
      </div>

    </div>

    <!-- 4-Column Structured Content Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-10 py-10 sm:py-12 border-b border-white/10">
      
      <!-- Col 1 (4 Cols): Culinary Heritage & Sewa Promise -->
      <div class="lg:col-span-4 space-y-3">
        <p class="font-editorial italic text-base sm:text-lg text-white/90 leading-snug">
          "Ghar Jaisa Swad. Seva Wala Pyar."
        </p>
        <p class="text-xs text-white/70 font-sans leading-relaxed max-w-sm">
          Roots in 1980, first highway hearth on Dewas Naka in 2005. Slow-simmered black urad dal, hand-crushed tandoori chur chur naan, and pure vegetarian hospitality across Indore.
        </p>
        <div class="pt-2 text-[11px] font-mono text-white/50 space-y-0.5">
          <p>• FSSAI Lic. No: {BRAND_INFO.fssaiNumber}</p>
          <p>• Daily Hours: 11:45 AM – 3:00 AM (365 Days)</p>
        </div>
      </div>

      <!-- Col 2 (2 Cols): Quick Navigation with Red Sliding Underline Animation -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">Quick Links</h4>
        <ul class="space-y-2.5 text-xs text-white/80 font-display uppercase tracking-wider">
          <li>
            <a href="/" class="relative inline-block text-white/80 hover:text-[#E4A834] py-0.5 transition-colors group">
              Home
              <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#D01B1B] transition-all duration-200 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="/all-categories" class="relative inline-block text-white/80 hover:text-[#E4A834] py-0.5 transition-colors group">
              All Categories
              <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#D01B1B] transition-all duration-200 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="/story" class="relative inline-block text-white/80 hover:text-[#E4A834] py-0.5 transition-colors group">
              Our Story
              <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#D01B1B] transition-all duration-200 group-hover:w-full"></span>
            </a>
          </li>
          <li>
            <a href="/outlets" class="relative inline-block text-white/80 hover:text-[#E4A834] py-0.5 transition-colors group">
              Five Outlets
              <span class="absolute bottom-0 left-0 w-0 h-[2px] bg-[#D01B1B] transition-all duration-200 group-hover:w-full"></span>
            </a>
          </li>
        </ul>
      </div>

      <!-- Col 3 (3 Cols): Socials & Community Section with Tailored Kinetic Animated Icons -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">Connect With Us</h4>
        <p class="text-xs text-white/70 font-sans leading-relaxed">
          Follow our culinary journey, late-night highway updates, and family gatherings.
        </p>

        <!-- Tailored Social Media Buttons Row -->
        <div class="pt-2 socials-row">
          
          <!-- Instagram -->
          <a
            href="https://instagram.com"
            target="_blank"
            rel="noopener noreferrer"
            class="socialContainer containerInstagram"
            title="Follow Nanaksar Dhaba on Instagram"
            aria-label="Instagram"
          >
            <svg class="socialSvg" viewBox="0 0 448 512">
              <path d="M224.1 141c-63.6 0-114.9 51.3-114.9 114.9s51.3 114.9 114.9 114.9S339 319.5 339 255.9 287.7 141 224.1 141zm0 189.6c-41.1 0-74.7-33.5-74.7-74.7s33.5-74.7 74.7-74.7 74.7 33.5 74.7 74.7-33.6 74.7-74.7 74.7zm146.4-194.3c0 14.9-12 26.8-26.8 26.8-14.9 0-26.8-12-26.8-26.8s12-26.8 26.8-26.8 26.8 12 26.8 26.8zm76.1 27.2c-1.7-35.9-9.9-67.7-36.2-93.9-26.2-26.2-58-34.4-93.9-36.2-37-2.1-147.9-2.1-184.9 0-35.8 1.7-67.6 9.9-93.9 36.1s-34.4 58-36.2 93.9c-2.1 37-2.1 147.9 0 184.9 1.7 35.9 9.9 67.7 36.2 93.9s58 34.4 93.9 36.2c37 2.1 147.9 2.1 184.9 0 35.9-1.7 67.7-9.9 93.9-36.2 26.2-26.2 34.4-58 36.2-93.9 2.1-37 2.1-147.8 0-184.8zM398.8 388c-7.8 19.6-22.9 34.7-42.6 42.6-29.5 11.7-99.5 9-132.1 9s-102.7 2.6-132.1-9c-19.6-7.8-34.7-22.9-42.6-42.6-11.7-29.5-9-99.5-9-132.1s-2.6-102.7 9-132.1c7.8-19.6 22.9-34.7 42.6-42.6 29.5-11.7 99.5-9 132.1-9s102.7-2.6 132.1 9c19.6 7.8 34.7 22.9 42.6 42.6 11.7 29.5 9 99.5 9 132.1s2.7 102.7-9 132.1z"/>
            </svg>
          </a>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/919826012345"
            target="_blank"
            rel="noopener noreferrer"
            class="socialContainer containerWhatsApp"
            title="Chat on WhatsApp"
            aria-label="WhatsApp"
          >
            <svg class="socialSvg" viewBox="0 0 448 512">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
            </svg>
          </a>

          <!-- Twitter / X -->
          <a
            href="https://twitter.com"
            target="_blank"
            rel="noopener noreferrer"
            class="socialContainer containerTwitter"
            title="Follow Nanaksar Dhaba on X"
            aria-label="X"
          >
            <svg class="socialSvg" viewBox="0 0 512 512">
              <path d="M389.2 48h70.6L305.6 224.2 487 464H345L233.7 318.6 106.5 464H35.8L200.7 275.5 26.8 48H172.4L272.9 180.9 389.2 48zM364.4 421.8h39.1L151.1 88h-42L364.4 421.8z"/>
            </svg>
          </a>

          <!-- Google Maps Reviews -->
          <a
            href="https://maps.google.com/?q=Nanaksar+Dhaba+Dewas+Naka+Indore"
            target="_blank"
            rel="noopener noreferrer"
            class="socialContainer containerGoogle"
            title="Review us on Google Maps"
            aria-label="Google Maps"
          >
            <svg class="socialSvg" viewBox="0 0 24 24">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
            </svg>
          </a>

        </div>
      </div>

      <!-- Col 4 (3 Cols): 5 Indore Outlets with Clean Single Icon per Location -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">5 Indore Branches</h4>
        <ul class="space-y-2 text-xs text-white/75 font-sans">
          {OUTLETS.map((o) => (
            <li>
              <a
                href={o.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-2.5 py-0.5 text-white/80 hover:text-white transition"
                title={`View ${o.name} on Google Maps`}
              >
                <svg class="w-3.5 h-3.5 text-[#E4A834] group-hover:text-[#D01B1B] shrink-0 transition-colors" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span class="font-medium text-white group-hover:text-[#E4A834] transition-colors leading-tight">
                  {o.name}
                </span>
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-1.5 text-[10px] font-mono text-green-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
          <span>Open late night until 3:00 AM</span>
        </div>
      </div>

    </div>

    <!-- Bottom Legal, Guarantee & Copyright Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-white/50 font-mono gap-4 pb-safe text-center md:text-left">
      <p>© {BRAND_INFO.established} – 2026 Nanaksar Dhaba (Indore). All Rights Reserved.</p>
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-3 sm:gap-4 text-[11px] text-white/40">
        <span>100% Pure Desi Ghee</span>
        <span>•</span>
        <span>Jain Kitchen Stations</span>
        <span>•</span>
        <span>Indore, Madhya Pradesh</span>
      </div>
    </div>

  </div>
</footer>
