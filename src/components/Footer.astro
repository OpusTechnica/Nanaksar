---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<footer class="bg-[#0A0A0A] text-white pt-14 sm:pt-18 pb-10 sm:pb-12 border-t border-white/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Header Ribbon: Brand Seal + Dietary Guarantee + Central Hotline -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 pb-10 border-b border-white/10">
      
      <!-- Brand Lockup -->
      <a href="/" class="flex items-center gap-3 sm:gap-3.5 group focus:outline-none focus:ring-1 focus:ring-[#E4A834] rounded-lg p-0.5 shrink-0 inline-flex">
        <img
          src="/assets/Logo.png"
          alt="Nanaksar Dhaba Seal"
          class="h-12 w-12 sm:h-14 sm:w-14 object-contain group-hover:scale-105 transition-transform shrink-0"
        />
        <div class="flex flex-col justify-center">
          <img
            src="/assets/Brand_Name.png"
            alt="Nanaksar Dhaba"
            class="h-8 sm:h-10 md:h-11 w-auto object-contain"
          />
          <span class="text-[9px] sm:text-[10px] md:text-[11px] font-display font-semibold tracking-widest text-[#E4A834] uppercase -mt-0.5">
            ESTD. {BRAND_INFO.established} • INDORE, M.P.
          </span>
        </div>
      </a>

      <!-- Helpline & Dietary Badge -->
      <div class="flex flex-wrap items-center gap-3 sm:gap-4">
        <div class="flex items-center gap-2 px-3 py-1.5 rounded-full bg-white/5 border border-white/10 text-xs font-mono text-white/80">
          <span class="w-2 h-2 rounded-full bg-green-500"></span>
          <span>100% SHUDDH PURE VEG</span>
        </div>

        <a
          href="tel:+919826012345"
          class="inline-flex items-center gap-2 bg-[#D01B1B] hover:bg-[#B81414] text-white px-5 py-2.5 rounded-xl text-xs font-display font-bold uppercase tracking-wider transition min-h-[40px]"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
          <span>Order Helpline: +91 98260 12345</span>
        </a>
      </div>

    </div>

    <!-- 4-Column Structured Content Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 sm:gap-10 py-10 sm:py-12 border-b border-white/10">
      
      <!-- Col 1 (4 Cols): Culinary Heritage & Sewa Promise -->
      <div class="lg:col-span-4 space-y-3">
        <p class="font-editorial italic text-base sm:text-lg text-white/90 leading-snug">
          "Ghar Jaisa Swad. Seva Wala Pyar."
        </p>
        <p class="text-xs text-white/70 font-sans leading-relaxed max-w-sm">
          Roots in 1980, first highway hearth on Dewas Naka in 2005. Slow-simmered black urad dal, hand-crushed tandoori chur chur naan, and pure vegetarian hospitality across Indore.
        </p>
        <div class="pt-2 text-[11px] font-mono text-white/50 space-y-0.5">
          <p>• FSSAI Lic. No: {BRAND_INFO.fssaiNumber}</p>
          <p>• Daily Hours: 11:45 AM – 3:00 AM (365 Days)</p>
        </div>
      </div>

      <!-- Col 2 (2 Cols): Quick Navigation -->
      <div class="lg:col-span-2 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">Quick Links</h4>
        <ul class="space-y-2 text-xs text-white/70 font-display uppercase tracking-wider">
          <li><a href="/" class="hover:text-[#E4A834] transition">Home</a></li>
          <li><a href="/all-categories" class="hover:text-[#E4A834] transition">All Categories</a></li>
          <li><a href="/story" class="hover:text-[#E4A834] transition">Our Story</a></li>
          <li><a href="/outlets" class="hover:text-[#E4A834] transition">Five Outlets</a></li>
        </ul>
      </div>

      <!-- Col 3 (3 Cols): Crown Signature Dishes -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">Signatures</h4>
        <ul class="space-y-2 text-xs text-white/70 font-sans">
          <li><a href="/all-categories" class="hover:text-white transition">24-Hr Dal Makhani • ₹195</a></li>
          <li><a href="/all-categories" class="hover:text-white transition">Clay-Oven Chur Chur Naan • ₹50</a></li>
          <li><a href="/all-categories" class="hover:text-white transition">Nanaksar Special Paneer • ₹200</a></li>
          <li><a href="/all-categories" class="hover:text-white transition">Paneer Angara (Smoky Dum) • ₹220</a></li>
          <li><a href="/all-categories" class="hover:text-white transition">Nanaksar Bhojan Thali • ₹240</a></li>
        </ul>
      </div>

      <!-- Col 4 (3 Cols): 5 Indore Outlets Direct Links -->
      <div class="lg:col-span-3 space-y-3">
        <h4 class="font-display text-xs font-bold uppercase tracking-[0.2em] text-[#E4A834]">5 Indore Branches</h4>
        <ul class="space-y-2 text-xs text-white/70 font-sans">
          {OUTLETS.map((o) => (
            <li class="flex items-center justify-between gap-2">
              <span class="text-white font-medium">{o.name}</span>
              <a href={o.mapsUrl} target="_blank" rel="noopener noreferrer" class="text-[10px] font-mono text-[#E4A834] hover:underline">
                Directions ↗
              </a>
            </li>
          ))}
        </ul>
        <div class="pt-1.5 text-[10px] font-mono text-green-400 flex items-center gap-1.5">
          <span class="w-1.5 h-1.5 rounded-full bg-green-500"></span>
          <span>Open late night until 3:00 AM</span>
        </div>
      </div>

    </div>

    <!-- Bottom Legal, Guarantee & Copyright Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between text-xs text-white/50 font-mono gap-4 pb-safe">
      <p>© {BRAND_INFO.established} – 2026 Nanaksar Dhaba (Indore). All Rights Reserved.</p>
      <div class="flex flex-wrap items-center gap-3 sm:gap-4 text-[11px] text-white/40">
        <span>100% Pure Desi Ghee</span>
        <span>•</span>
        <span>Jain Kitchen Stations</span>
        <span>•</span>
        <span>Indore, Madhya Pradesh</span>
      </div>
    </div>

  </div>
</footer>
