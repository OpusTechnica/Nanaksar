---
const PLATFORMS = [
  {
    id: "swiggy",
    partnerTag: "DELIVERY PARTNER",
    tagColor: "text-[#842F06]",
    name: "SWIGGY",
    subtitle: "Fast Doorstep Delivery",
    rating: "4.2",
    reviewCount: "2.6K+ ratings",
    url: "https://www.swiggy.com/city/indore/nanaksar-dhaba-vijay-nagar-rest133832",
    btnText: "Order on Swiggy",
    btnClass: "bg-[#FC8019] hover:bg-[#E56F08] text-white",
    cardBorder: "hover:border-[#FC8019]",
    iconType: "swiggy"
  },
  {
    id: "zomato",
    partnerTag: "DELIVERY PARTNER",
    tagColor: "text-[#D01B1B]",
    name: "ZOMATO",
    subtitle: "Live Tracking & Offers",
    rating: "4.1",
    reviewCount: "1.8K+ ratings",
    url: "https://www.zomato.com/indore/nanaksar-dhaba-dewas-naka",
    btnText: "Order on Zomato",
    btnClass: "bg-[#D01B1B] hover:bg-[#B81414] text-white",
    cardBorder: "hover:border-[#D01B1B]",
    iconType: "zomato"
  },
  {
    id: "magicpin",
    partnerTag: "DINING & SAVINGS",
    tagColor: "text-[#5B3CE6]",
    name: "MAGICPIN",
    subtitle: "Exclusive City Vouchers",
    rating: "4.3",
    reviewCount: "900+ ratings",
    url: "https://magicpin.in/Indore/Dewas-Naka/Restaurant/Nanaksar-Dhaba/",
    btnText: "Order on Magicpin",
    btnClass: "bg-[#5B3CE6] hover:bg-[#4828D6] text-white",
    cardBorder: "hover:border-[#5B3CE6]",
    iconType: "magicpin"
  },
  {
    id: "google",
    partnerTag: "VERIFIED REVIEWS",
    tagColor: "text-[#1A73E8]",
    name: "GOOGLE MAPS",
    subtitle: "Real Diner Experiences",
    rating: "4.4",
    reviewCount: "1.2K+ reviews",
    url: "https://maps.google.com/?q=Nanaksar+Dhaba+Dewas+Naka+Indore",
    btnText: "View on Google",
    btnClass: "bg-[#1A73E8] hover:bg-[#1557B0] text-white",
    cardBorder: "hover:border-[#1A73E8]",
    iconType: "google"
  }
];
---

<section id="platforms" class="py-14 sm:py-20 bg-[#F7F4EB] text-[#0F0F0F] border-t border-[#0F0F0F]/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Eyebrow & Headline -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full border border-[#965C00]/30 bg-white mb-3">
        <span class="font-display text-[10px] sm:text-xs font-bold tracking-[0.25em] text-[#965C00] uppercase">
          OFFICIAL PLATFORMS
        </span>
      </div>

      <h2 class="font-display text-3xl sm:text-5xl font-bold uppercase tracking-tight text-[#0F0F0F] leading-[0.95]">
        Available on <span class="text-[#D01B1B]">Partner Apps</span>
      </h2>

      <p class="mt-2.5 text-xs sm:text-sm text-[#0F0F0F]/70 font-sans max-w-xl mx-auto">
        Verified presence across Indore delivery networks with authentic diner ratings.
      </p>
    </div>

    <!-- 4 Platform Cards Grid (Compact & Clean) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 items-stretch">
      {PLATFORMS.map((p) => (
        <div class={`bg-white rounded-2xl p-5 sm:p-6 border border-[#0F0F0F]/10 ${p.cardBorder} transition-all duration-200 flex flex-col justify-between text-center group`}>
          
          <div>
            <!-- Top Partner Tag -->
            <p class={`text-[9px] font-mono font-bold tracking-wider uppercase mb-3 ${p.tagColor}`}>
              {p.partnerTag}
            </p>

            <!-- Brand Icon Badge -->
            <div class="mb-3 flex justify-center">
              {p.iconType === 'swiggy' && (
                <div class="w-12 h-12 rounded-full bg-[#FC8019] flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-6 h-6 fill-white" viewBox="0 0 32 32">
                    <path d="M16 2C10.5 2 6 6.5 6 12c0 7.5 9 17.5 9.5 18 .3.3.7.3 1 0 .5-.5 9.5-10.5 9.5-18 0-5.5-4.5-10-10-10zm0 14.5c-2.5 0-4.5-2-4.5-4.5S13.5 7.5 16 7.5s4.5 2 4.5 4.5-2 4.5-4.5 4.5z"/>
                  </svg>
                </div>
              )}

              {p.iconType === 'zomato' && (
                <div class="w-12 h-12 rounded-full bg-[#D01B1B] flex items-center justify-center group-hover:scale-105 transition-transform px-2">
                  <span class="font-sans font-black text-white text-xs tracking-tighter lowercase italic transform -rotate-1">
                    zomato
                  </span>
                </div>
              )}

              {p.iconType === 'magicpin' && (
                <div class="w-12 h-12 rounded-full bg-[#5B3CE6] flex items-center justify-center group-hover:scale-105 transition-transform px-2">
                  <span class="font-sans font-bold text-white text-[11px] tracking-tight lowercase">
                    magicpin
                  </span>
                </div>
              )}

              {p.iconType === 'google' && (
                <div class="w-12 h-12 rounded-full bg-[#F7F4EB] border border-[#0F0F0F]/10 flex items-center justify-center group-hover:scale-105 transition-transform">
                  <svg class="w-6 h-6" viewBox="0 0 24 24">
                    <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
                    <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                    <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z"/>
                    <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z"/>
                  </svg>
                </div>
              )}
            </div>

            <!-- Platform Name -->
            <h3 class="font-display text-lg sm:text-xl font-bold uppercase text-[#0F0F0F] tracking-wide">
              {p.name}
            </h3>
            <p class="text-[11px] text-[#0F0F0F]/60 font-sans mt-0.5">
              {p.subtitle}
            </p>

            <!-- Inner Rating Badge -->
            <div class="bg-[#F7F4EB] rounded-xl p-2 my-4 border border-[#0F0F0F]/10 text-center">
              <div class="flex items-center justify-center gap-1.5 text-xs font-mono font-bold text-[#0F0F0F]">
                <span class="text-[#965C00]">★ {p.rating}</span>
                <span class="text-[#0F0F0F]/20">|</span>
                <span class="text-[#0F0F0F]/60 text-[11px] font-sans font-normal">{p.reviewCount}</span>
              </div>
            </div>
          </div>

          <!-- Direct Link Button -->
          <a
            href={p.url}
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full flex items-center justify-center gap-1.5 py-2.5 px-3 rounded-xl font-display text-xs font-bold uppercase tracking-wider transition ${p.btnClass} min-h-[40px]`}
          >
            <span>{p.btnText}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>

        </div>
      ))}
    </div>

    <!-- Verified Ribbon -->
    <div class="flex items-center justify-center gap-3 mt-8 sm:mt-10 text-[10px] font-mono tracking-widest text-[#965C00] uppercase">
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
      <span class="text-[#0F0F0F]/60">100% Verified Official Outlets</span>
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
    </div>

  </div>
</section>
