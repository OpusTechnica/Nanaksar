---
import { OUTLETS } from '../data/restaurantData';

const flagshipOutlet = OUTLETS.find((o) => o.isFlagship) || OUTLETS[0];
const cityHubs = OUTLETS.filter((o) => !o.isFlagship);
---

<section id="outlets" class="py-16 sm:py-24 bg-[#F7F4EB] text-[#0F0F0F] border-t border-[#0F0F0F]/10 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#965C00]/30 text-[#965C00] text-xs font-bold uppercase tracking-wider mb-3 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#965C00]"></span>
        <span>FIVE STRATEGIC INDORE HUBS</span>
      </div>
      <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-[#0F0F0F] leading-tight">
        Five Outlets. <span class="text-[#D01B1B]">One Tradition.</span>
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-[#0F0F0F]/70 max-w-xl mx-auto font-sans leading-relaxed">
        From our 2005 highway hearth at Dewas Naka to city dining hubs across Indore. Open 365 days from 11:45 AM to 3:00 AM for dine-in, takeaway, and family meals.
      </p>
    </div>

    <!-- 1. Featured Flagship Hearth Showcase (Dewas Naka) -->
    <div class="mb-6 sm:mb-8">
      <div class="bg-white rounded-3xl border-2 border-[#E4A834]/60 p-6 sm:p-8 lg:p-10 shadow-[0_4px_24px_rgba(228,168,52,0.08)] relative overflow-hidden group">
        <!-- Ambient Gold Corner Flare -->
        <div class="absolute -top-12 -right-12 w-36 h-36 rounded-full bg-[#E4A834]/10 pointer-events-none"></div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
          
          <!-- Left: Flagship Credentials -->
          <div class="lg:col-span-8 space-y-3 sm:space-y-4">
            <div class="flex flex-wrap items-center gap-2.5">
              <span class="text-[10px] font-mono font-black px-3 py-1 rounded-full bg-[#E4A834]/20 text-[#842F06] border border-[#E4A834]/50 uppercase tracking-widest">
                ★ {flagshipOutlet.tag}
              </span>
              <span class="text-[10px] font-mono text-green-700 font-bold flex items-center gap-1.5 bg-green-50 px-2.5 py-1 rounded-full border border-green-200">
                <span class="w-2 h-2 rounded-full bg-green-600 animate-pulse"></span>
                OPEN UNTIL 3:00 AM
              </span>
            </div>

            <h3 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold uppercase text-[#0F0F0F] leading-tight">
              {flagshipOutlet.name} — <span class="text-[#842F06]">{flagshipOutlet.subtitle}</span>
            </h3>

            <p class="text-xs sm:text-sm text-[#0F0F0F]/75 font-sans leading-relaxed max-w-2xl">
              <strong class="text-[#0F0F0F]">Address:</strong> {flagshipOutlet.address}
            </p>

            <div class="flex flex-wrap items-center gap-4 sm:gap-6 text-xs font-mono text-[#0F0F0F]/70 pt-1">
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E4A834]"></span>
                <span>Daily Hours: <strong>{flagshipOutlet.timings}</strong></span>
              </div>
              <div class="flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-[#E4A834]"></span>
                <span>Phone: <strong>{flagshipOutlet.phone}</strong></span>
              </div>
            </div>
          </div>

          <!-- Right: Flagship Quick Action Buttons -->
          <div class="lg:col-span-4 flex flex-col sm:flex-row lg:flex-col gap-3 justify-center">
            <a
              href={flagshipOutlet.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 bg-[#0F0F0F] hover:bg-[#D01B1B] text-white text-xs font-display font-bold uppercase tracking-wider py-3.5 px-5 rounded-xl transition-all duration-200 shadow-md min-h-[44px] active:scale-[0.98]"
            >
              <svg class="w-4 h-4 text-[#E4A834]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              <span>Get Flagship Directions</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>

            <a
              href={`tel:${flagshipOutlet.phone.replace(/\s/g, '')}`}
              class="w-full inline-flex items-center justify-center gap-2 bg-white hover:bg-[#F7F4EB] text-[#0F0F0F] text-xs font-display font-bold uppercase tracking-wider py-3.5 px-5 rounded-xl border border-[#0F0F0F]/15 transition min-h-[44px]"
            >
              <svg class="w-3.5 h-3.5 text-[#D01B1B]" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/></svg>
              <span>Call Dewas Naka Outlet</span>
            </a>
          </div>

        </div>
      </div>
    </div>

    <!-- 2. The 4 City Hub Outlets Grid (Spacious 4-Col or 2x2 Clean Cards) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 items-stretch">
      {cityHubs.map((outlet) => (
        <div class="bg-white p-5 sm:p-6 rounded-2xl border border-[#0F0F0F]/10 hover:border-[#D01B1B] transition-all duration-200 flex flex-col justify-between group shadow-[0_2px_10px_rgba(0,0,0,0.02)] hover:shadow-[0_6px_20px_rgba(0,0,0,0.05)]">
          <div>
            <!-- Top Tag & Status -->
            <div class="flex items-center justify-between gap-1 mb-2.5">
              <span class={`text-[9px] font-mono font-bold px-2 py-0.5 rounded uppercase tracking-wider ${
                outlet.isNew 
                  ? 'bg-green-100 text-green-800 border border-green-300' 
                  : 'bg-[#F7F4EB] text-[#965C00] border border-[#965C00]/20'
              }`}>
                {outlet.tag}
              </span>
              <span class="text-[9px] font-mono text-green-700 font-semibold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                OPEN
              </span>
            </div>

            <!-- Outlet Name & Hub Subtitle -->
            <h3 class="font-display text-lg sm:text-xl font-bold uppercase text-[#0F0F0F] group-hover:text-[#D01B1B] transition leading-snug">
              {outlet.name}
            </h3>
            <p class="text-[11px] font-display text-[#842F06] uppercase tracking-wide font-semibold mt-0.5">
              {outlet.subtitle}
            </p>

            <!-- Concise Address -->
            <p class="text-xs text-[#0F0F0F]/65 mt-2 font-sans line-clamp-2 leading-relaxed">
              {outlet.address}
            </p>
          </div>

          <!-- Bottom Timings & Actions -->
          <div class="mt-4 pt-3.5 border-t border-[#0F0F0F]/8">
            <div class="text-[10px] font-mono text-[#0F0F0F]/60 flex items-center justify-between mb-3">
              <span>Hours:</span>
              <span class="font-bold text-[#0F0F0F]/80">11:45 AM – 3:00 AM</span>
            </div>
            
            <div class="grid grid-cols-2 gap-2">
              <a
                href={outlet.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1 bg-[#F7F4EB] hover:bg-[#0F0F0F] hover:text-white text-[#0F0F0F] text-[11px] font-display font-bold uppercase py-2 px-1 rounded-lg transition min-h-[38px] border border-[#0F0F0F]/10 active:scale-[0.98]"
              >
                <svg class="w-3 h-3 text-[#965C00]" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                </svg>
                <span>Maps</span>
              </a>

              <a
                href={`tel:${outlet.phone.replace(/\s/g, '')}`}
                class="inline-flex items-center justify-center gap-1 bg-[#D01B1B] hover:bg-[#B81414] text-white text-[11px] font-display font-bold uppercase py-2 px-1 rounded-lg transition min-h-[38px] active:scale-[0.98]"
              >
                <span>Call</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Presence Footer Ribbon -->
    <div class="flex items-center justify-center gap-3 mt-8 sm:mt-12 text-[10px] font-mono tracking-widest text-[#965C00] uppercase">
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
      <span class="text-[#0F0F0F]/60">Pure Veg Highway Dining across all 5 Indore Branches</span>
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
    </div>

  </div>
</section>
