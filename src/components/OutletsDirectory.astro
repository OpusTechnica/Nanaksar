---
import { OUTLETS } from '../data/restaurantData';
---

<section id="outlets" class="py-16 sm:py-24 bg-[#F7F4EB] text-[#0F0F0F] border-t border-[#0F0F0F]/10">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#965C00]/30 text-[#965C00] text-xs font-bold uppercase tracking-wider mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-[#965C00]"></span>
        <span>FIVE STRATEGIC INDORE HUBS</span>
      </div>
      <h2 class="font-display text-4xl sm:text-6xl font-bold uppercase tracking-tight text-[#0F0F0F] leading-tight">
        Five Outlets. <span class="text-[#D01B1B]">One Tradition.</span>
      </h2>
      <p class="mt-2 text-xs sm:text-sm text-[#0F0F0F]/70 max-w-lg mx-auto font-sans">
        Authentic highway dining across Indore. Open daily from 11:45 AM to 3:00 AM for dine-in, takeaway, and family meals.
      </p>
    </div>

    <!-- 5 Outlets in 1 Single Desktop Row (Ultra-Tailored & Premium) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 sm:gap-4 items-stretch">
      {OUTLETS.map((outlet) => (
        <div class="bg-white p-4 sm:p-5 rounded-2xl border border-[#0F0F0F]/10 hover:border-[#D01B1B] transition-all duration-200 flex flex-col justify-between group shadow-[0_2px_8px_rgba(0,0,0,0.02)]">
          <div>
            <!-- Top Tag & Status -->
            <div class="flex items-center justify-between gap-1 mb-2">
              <span class={`text-[9px] font-mono font-bold px-2 py-0.5 rounded uppercase tracking-wider ${
                outlet.isFlagship
                  ? 'bg-[#E4A834]/20 text-[#842F06] border border-[#E4A834]/40 font-black'
                  : (outlet.isNew ? 'bg-green-100 text-green-800 border border-green-300' : 'bg-[#F7F4EB] text-[#965C00]')
              }`}>
                {outlet.tag}
              </span>
              <span class="text-[9px] font-mono text-green-700 font-semibold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-green-600"></span>
                OPEN
              </span>
            </div>

            <!-- Outlet Name & Hub Subtitle -->
            <h3 class="font-display text-lg sm:text-xl font-bold uppercase text-[#0F0F0F] group-hover:text-[#D01B1B] transition leading-snug">
              {outlet.name}
            </h3>
            <p class="text-[11px] font-display text-[#842F06] uppercase tracking-wide font-semibold mt-0.5">
              {outlet.subtitle}
            </p>

            <!-- Concise Address -->
            <p class="text-xs text-[#0F0F0F]/65 mt-2 font-sans line-clamp-2 leading-relaxed">
              {outlet.address}
            </p>
          </div>

          <!-- Bottom Timings & Actions -->
          <div class="mt-4 pt-3 border-t border-[#0F0F0F]/8">
            <div class="text-[10px] font-mono text-[#0F0F0F]/60 flex items-center justify-between mb-3">
              <span>Daily Hours:</span>
              <span class="font-bold text-[#0F0F0F]/80">11:45 AM – 3:00 AM</span>
            </div>
            
            <div class="grid grid-cols-2 gap-1.5">
              <a
                href={outlet.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center gap-1 bg-[#F7F4EB] hover:bg-[#0F0F0F] hover:text-white text-[#0F0F0F] text-[11px] font-display font-bold uppercase py-2 px-1 rounded-lg transition min-h-[36px] border border-[#0F0F0F]/10"
              >
                <span>Maps</span>
                <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>

              <a
                href={`tel:${outlet.phone.replace(/\s/g, '')}`}
                class="inline-flex items-center justify-center gap-1 bg-[#D01B1B] hover:bg-[#B81414] text-white text-[11px] font-display font-bold uppercase py-2 px-1 rounded-lg transition min-h-[36px]"
              >
                <span>Call</span>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Verified Presence Footer Ribbon -->
    <div class="flex items-center justify-center gap-3 mt-8 sm:mt-10 text-[10px] font-mono tracking-widest text-[#965C00] uppercase">
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
      <span class="text-[#0F0F0F]/60">Pure Veg Family Dining • Table Booking &amp; Takeaways</span>
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
    </div>

  </div>
</section>
