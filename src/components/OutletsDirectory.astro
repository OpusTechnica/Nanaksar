---
import OutletsStack from './OutletsStack';

interface Props {
  isPage?: boolean;
}

const { isPage = false } = Astro.props;
---

<section id="outlets" class={`bg-[#F7F4EB] text-[#0F0F0F] relative overflow-hidden ${isPage ? 'pt-24 sm:pt-28 pb-16 sm:pb-24' : 'py-16 sm:py-24 border-t border-[#0F0F0F]/10'}`}>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white border border-[#965C00]/30 text-[#965C00] text-xs font-bold uppercase tracking-wider mb-3 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#965C00]"></span>
        <span>FIVE STRATEGIC INDORE HUBS</span>
      </div>
      {isPage ? (
        <h1 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-[#0F0F0F] leading-tight">
          Five Outlets. <span class="text-[#D01B1B]">One Tradition.</span>
        </h1>
      ) : (
        <h2 class="font-display text-3xl sm:text-5xl lg:text-6xl font-bold uppercase tracking-tight text-[#0F0F0F] leading-tight">
          Five Outlets. <span class="text-[#D01B1B]">One Tradition.</span>
        </h2>
      )}
      <p class="mt-2 text-xs sm:text-sm text-[#0F0F0F]/70 max-w-xl mx-auto font-sans leading-relaxed">
        From our 2005 highway hearth at Dewas Naka to city dining hubs across Indore. Open 365 days from 11:45 AM to 3:00 AM for dine-in, takeaway, and family meals.
      </p>
    </div>

    <!-- Stacked Outlet Cards: flagship first, then city hubs (scroll-driven, motion) -->
    <OutletsStack client:visible />

    <!-- Verified Presence Footer Ribbon -->
    <div class="flex items-center justify-center gap-3 mt-8 sm:mt-12 text-[10px] font-mono tracking-widest text-[#965C00] uppercase">
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
      <span class="text-[#0F0F0F]/60">Pure Veg Highway Dining across all 5 Indore Branches</span>
      <div class="w-10 sm:w-16 h-[1px] bg-[#965C00]/30"></div>
    </div>

  </div>
</section>
