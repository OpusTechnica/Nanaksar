---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<div class="relative z-20 w-full pt-4 sm:pt-8 pb-3 sm:pb-5">
  <!-- Mobile: Swipeable Snap Ribbon | Desktop: 4-Pillar Grid -->
  <div class="w-full overflow-x-auto snap-x snap-mandatory scroll-px-4 sm:scroll-px-6 overscroll-x-contain no-scrollbar touch-pan-x lg:overflow-visible">
    <div class="flex lg:grid lg:grid-cols-4 w-max lg:w-full gap-3 sm:gap-4 items-stretch px-1 lg:px-0">
      
      <!-- Card 1: 5 Outlets -->
      <a
        href="/outlets"
        class="snap-start snap-always w-[200px] lg:w-auto bg-white/[0.04] hover:bg-white/[0.08] backdrop-blur-md border border-white/10 hover:border-[#E4A834]/50 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-4 sm:p-5 transition-all duration-200 group flex flex-col justify-center"
      >
        <span class="text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-1">
          LOCATIONS
        </span>
        <span class="font-display text-2xl sm:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block">
          5 Outlets
        </span>
        <p class="text-xs text-white/70 font-sans mt-0.5">
          Across Indore Hubs
        </p>
      </a>

      <!-- Card 2: 4.5 Star Rating -->
      <div class="snap-start snap-always w-[200px] lg:w-auto bg-white/[0.04] backdrop-blur-md border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-4 sm:p-5 flex flex-col justify-center">
        <span class="text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-1">
          RATING
        </span>
        <span class="font-display text-2xl sm:text-3xl font-bold uppercase text-[#E4A834] block">
          4.5★ Rating
        </span>
        <p class="text-xs text-white/70 font-sans mt-0.5">
          5,000+ Diners
        </p>
      </div>

      <!-- Card 3: 100% Pure Veg -->
      <div class="snap-start snap-always w-[200px] lg:w-auto bg-white/[0.04] backdrop-blur-md border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-4 sm:p-5 flex flex-col justify-center">
        <span class="text-[10px] font-mono text-green-400 uppercase tracking-widest font-bold block mb-1">
          PURITY
        </span>
        <span class="font-display text-2xl sm:text-3xl font-bold uppercase text-white block">
          100% Pure Veg
        </span>
        <p class="text-xs text-white/70 font-sans mt-0.5">
          Pure Desi Ghee
        </p>
      </div>

      <!-- Card 4: Since 1980 -->
      <a
        href="/story"
        class="snap-start snap-always w-[200px] lg:w-auto bg-white/[0.04] hover:bg-white/[0.08] backdrop-blur-md border border-white/10 hover:border-[#E4A834]/50 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-4 sm:p-5 transition-all duration-200 group flex flex-col justify-center"
      >
        <span class="text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-1">
          HERITAGE
        </span>
        <span class="font-display text-2xl sm:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block">
          Since 1980
        </span>
        <p class="text-xs text-white/70 font-sans mt-0.5">
          45+ Yrs Indore Swad
        </p>
      </a>

      <!-- Trailing Spacer for mobile snap scroll safety -->
      <div class="w-4 shrink-0 lg:hidden"></div>

    </div>
  </div>
</div>
