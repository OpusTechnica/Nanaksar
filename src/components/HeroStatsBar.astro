---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<div class="relative z-20 w-full pt-3 sm:pt-8 pb-2 sm:pb-5">
  <!-- Mobile: 2x2 Fitted Grid (All 4 Visible) | Desktop: 4-Pillar Grid -->
  <div id="hero-stats-container" class="grid grid-cols-2 lg:grid-cols-4 gap-2.5 sm:gap-3.5 lg:gap-4 w-full items-stretch">
    
    <!-- Card 1: 5 Outlets -->
    <a
      href="/outlets"
      class="bg-[#141414]/95 sm:bg-white/[0.04] hover:bg-white/[0.08] sm:backdrop-blur-md border border-white/10 hover:border-[#E4A834]/50 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-3 sm:p-4 lg:p-5 transition-all duration-200 group flex flex-col justify-center"
    >
      <span class="text-[9px] xs:text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-0.5 sm:mb-1">
        LOCATIONS
      </span>
      <span class="font-display text-lg xs:text-xl sm:text-2xl lg:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block leading-tight">
        <span data-counter="num" data-target="5" data-start="0">5</span> Outlets
      </span>
      <p class="text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        Across Indore Hubs
      </p>
    </a>

    <!-- Card 2: 4.5 Star Rating -->
    <div class="bg-[#141414]/95 sm:bg-white/[0.04] sm:backdrop-blur-md border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-3 sm:p-4 lg:p-5 flex flex-col justify-center">
      <span class="text-[9px] xs:text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-0.5 sm:mb-1">
        RATING
      </span>
      <span class="font-display text-lg xs:text-xl sm:text-2xl lg:text-3xl font-bold uppercase text-[#E4A834] block leading-tight">
        <span data-counter="num" data-target="4.5" data-start="0" data-decimals="1">4.5</span>★ Rating
      </span>
      <p class="text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        5,000+ Diners
      </p>
    </div>

    <!-- Card 3: 100% Pure Veg -->
    <div class="bg-[#141414]/95 sm:bg-white/[0.04] sm:backdrop-blur-md border border-white/10 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-3 sm:p-4 lg:p-5 flex flex-col justify-center">
      <span class="text-[9px] xs:text-[10px] font-mono text-green-400 uppercase tracking-widest font-bold block mb-0.5 sm:mb-1">
        PURITY
      </span>
      <span class="font-display text-lg xs:text-xl sm:text-2xl lg:text-3xl font-bold uppercase text-white block leading-tight">
        <span data-counter="num" data-target="100" data-start="0">100</span>% Pure Veg
      </span>
      <p class="text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        Pure Desi Ghee
      </p>
    </div>

    <!-- Card 4: Since 1980 -->
    <a
      href="/story"
      class="bg-[#141414]/95 sm:bg-white/[0.04] hover:bg-white/[0.08] sm:backdrop-blur-md border border-white/10 hover:border-[#E4A834]/50 shadow-[inset_0_1px_0_0_rgba(255,255,255,0.10)] rounded-2xl p-3 sm:p-4 lg:p-5 transition-all duration-200 group flex flex-col justify-center"
    >
      <span class="text-[9px] xs:text-[10px] font-mono text-[#E4A834] uppercase tracking-widest font-bold block mb-0.5 sm:mb-1">
        HERITAGE
      </span>
      <span class="font-display text-lg xs:text-xl sm:text-2xl lg:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block leading-tight">
        Since <span data-counter="num" data-target="1980" data-start="0">1980</span>
      </span>
      <p class="text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        45+ Yrs Indore Swad
      </p>
    </a>

  </div>
</div>

<script is:inline>
  function initStatsAnimation() {
    const container = document.getElementById('hero-stats-container');
    if (!container) return;

    const counters = container.querySelectorAll('[data-counter="num"]');
    if (!counters.length) return;

    // Reset counters to 0 initially
    counters.forEach((el) => {
      const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
      el.textContent = decimals > 0 ? (0).toFixed(decimals) : '0';
    });

    let hasAnimated = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && !hasAnimated) {
          hasAnimated = true;
          observer.disconnect();

          const duration = 1400; // ms
          const startTime = performance.now();
          const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);

          function update(now) {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = easeOutCubic(progress);

            counters.forEach((el) => {
              const target = parseFloat(el.getAttribute('data-target') || '0');
              const start = parseFloat(el.getAttribute('data-start') || '0');
              const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
              const val = start + (target - start) * eased;

              el.textContent = decimals > 0 ? val.toFixed(decimals) : Math.round(val).toString();
            });

            if (progress < 1) {
              requestAnimationFrame(update);
            }
          }

          requestAnimationFrame(update);
        }
      });
    }, { threshold: 0.15 });

    observer.observe(container);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsAnimation);
  } else {
    initStatsAnimation();
  }
  document.addEventListener('astro:page-load', initStatsAnimation);
</script>
