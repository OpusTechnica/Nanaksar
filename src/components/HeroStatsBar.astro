---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<div class="relative z-20 w-full pt-3 sm:pt-8 pb-2 sm:pb-5">
  <!-- Mobile: Integrated Minimalist Precision Ribbon | Desktop: 4-Pillar Authoritative Cards -->
  <div
    id="hero-stats-container"
    class="grid grid-cols-4 sm:gap-3.5 lg:gap-4 w-full max-w-[370px] sm:max-w-none bg-[#141414]/75 sm:bg-transparent backdrop-blur-md sm:backdrop-blur-none border border-white/10 sm:border-0 rounded-2xl sm:rounded-none divide-x divide-white/10 sm:divide-x-0 items-stretch shadow-[0_4px_20px_rgba(0,0,0,0.5)] sm:shadow-none"
  >
    
    <!-- Card 1: 5 Outlets -->
    <a
      href="/outlets"
      class="py-2.5 px-1 sm:p-4 lg:p-5 flex flex-col justify-center text-center sm:text-left sm:bg-white/[0.04] sm:hover:bg-white/[0.08] sm:backdrop-blur-md sm:border sm:border-white/10 sm:hover:border-[#E4A834]/50 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] sm:rounded-2xl transition-all duration-200 group"
    >
      <span class="hidden sm:block text-[9px] xs:text-[10px] sm:text-xs font-mono text-[#E4A834] uppercase tracking-widest font-bold mb-1">
        LOCATIONS
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-2xl lg:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block leading-tight">
        <span data-counter="num" data-target="5" data-start="1" class="tabular-nums">5</span> <span class="text-[10px] xs:text-xs sm:text-lg lg:text-3xl font-medium sm:font-bold text-white/85 sm:text-white">Outlets</span>
      </span>
      <p class="hidden sm:block text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        Across Indore Hubs
      </p>
    </a>

    <!-- Card 2: 4.5 Star Rating -->
    <div class="py-2.5 px-1 sm:p-4 lg:p-5 flex flex-col justify-center text-center sm:text-left sm:bg-white/[0.04] sm:backdrop-blur-md sm:border sm:border-white/10 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] sm:rounded-2xl">
      <span class="hidden sm:block text-[9px] xs:text-[10px] sm:text-xs font-mono text-[#E4A834] uppercase tracking-widest font-bold mb-1">
        RATING
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-2xl lg:text-3xl font-bold uppercase text-[#E4A834] flex items-center justify-center sm:justify-start gap-0.5 leading-tight">
        <span data-counter="num" data-target="4.5" data-start="3.8" data-decimals="1" class="tabular-nums">4.5</span><svg class="w-2.5 h-2.5 xs:w-3 xs:h-3 sm:w-5 sm:h-5 shrink-0" aria-hidden="true"><use href="/assets/icons.svg#star-solid"/></svg><span class="hidden sm:inline text-lg lg:text-3xl font-bold"> Rating</span>
      </span>
      <p class="hidden sm:block text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        5,000+ Diners
      </p>
    </div>

    <!-- Card 3: 100% Pure Veg -->
    <div class="py-2.5 px-1 sm:p-4 lg:p-5 flex flex-col justify-center text-center sm:text-left sm:bg-white/[0.04] sm:backdrop-blur-md sm:border sm:border-white/10 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] sm:rounded-2xl">
      <span class="hidden sm:block text-[9px] xs:text-[10px] sm:text-xs font-mono text-green-400 uppercase tracking-widest font-bold mb-1">
        PURITY
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-2xl lg:text-3xl font-bold uppercase text-white block leading-tight">
        <span data-counter="num" data-target="100" data-start="75" class="tabular-nums">100</span>% <span class="text-[10px] xs:text-xs sm:text-lg lg:text-3xl font-medium sm:font-bold text-white/85 sm:text-white">Veg</span>
      </span>
      <p class="hidden sm:block text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        Pure Desi Ghee
      </p>
    </div>

    <!-- Card 4: Since 1980 -->
    <a
      href="/story"
      class="py-2.5 px-1 sm:p-4 lg:p-5 flex flex-col justify-center text-center sm:text-left sm:bg-white/[0.04] sm:hover:bg-white/[0.08] sm:backdrop-blur-md sm:border sm:border-white/10 sm:hover:border-[#E4A834]/50 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.08)] sm:rounded-2xl transition-all duration-200 group"
    >
      <span class="hidden sm:block text-[9px] xs:text-[10px] sm:text-xs font-mono text-[#E4A834] uppercase tracking-widest font-bold mb-1">
        HERITAGE
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-2xl lg:text-3xl font-bold uppercase text-white group-hover:text-[#E4A834] transition block leading-tight">
        <span class="text-[10px] xs:text-xs sm:text-lg lg:text-3xl font-medium sm:font-bold text-white/85 sm:text-white">Est. </span><span data-counter="num" data-target="1980" data-start="1950" class="tabular-nums">1980</span>
      </span>
      <p class="hidden sm:block text-[10px] xs:text-[11px] sm:text-xs text-white/70 font-sans mt-0.5 truncate">
        45+ Yrs Indore Swad
      </p>
    </a>

  </div>
</div>

<script is:inline>
  function initStatsAnimation() {
    const container = document.getElementById('hero-stats-container');
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = container.querySelectorAll('[data-counter="num"]');
    if (!counters.length) return;

    // Reduced motion: render final target values immediately
    if (reduceMotion) {
      counters.forEach((el) => {
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        el.textContent = decimals > 0 ? target.toFixed(decimals) : Math.round(target).toString();
      });
      return;
    }

    let hasRun = false;

    function runCounters() {
      if (hasRun) return;
      hasRun = true;

      // Silky-smooth Quintic Ease-Out (fast initial glide, ultra-soft gentle deceleration)
      const easeOutQuint = (t) => 1 - Math.pow(1 - t, 5);

      counters.forEach((el, index) => {
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const start = parseFloat(el.getAttribute('data-start') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);

        // Set baseline start immediately
        el.textContent = decimals > 0 ? start.toFixed(decimals) : Math.round(start).toString();

        // 60ms natural cascade stagger between cards
        const delay = index * 60;
        const duration = 1100 + index * 80; // 1100ms - 1340ms calibrated duration

        setTimeout(() => {
          let startTime = null;

          function frame(now) {
            if (!startTime) startTime = now;
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = easeOutQuint(progress);
            const currentVal = start + (target - start) * eased;

            el.textContent = decimals > 0 ? currentVal.toFixed(decimals) : Math.round(currentVal).toString();

            if (progress < 1) {
              requestAnimationFrame(frame);
            } else {
              // Lock into exact target
              el.textContent = decimals > 0 ? target.toFixed(decimals) : target.toString();

              // Micro-settle kinetic feedback: subtle tactile finish
              el.animate([
                { transform: 'scale(1.06)', opacity: 0.95 },
                { transform: 'scale(1)', opacity: 1 }
              ], { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
            }
          }

          requestAnimationFrame(frame);
        }, delay);
      });
    }

    // Coordinate with Welcome Entrance Screen
    if (document.documentElement.classList.contains('curtain-gate-active')) {
      // User is on welcome entrance: wait for curtains to part before counting!
      window.addEventListener('threshold:entered', () => {
        setTimeout(runCounters, 200);
      }, { once: true });
    } else {
      // Direct visitor or returning user: trigger when scrolled into view
      const observer = new IntersectionObserver((entries) => {
        if (entries[0] && entries[0].isIntersecting) {
          observer.disconnect();
          runCounters();
        }
      }, { threshold: 0.15 });
      observer.observe(container);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsAnimation);
  } else {
    initStatsAnimation();
  }
  document.addEventListener('astro:page-load', initStatsAnimation);
</script>
