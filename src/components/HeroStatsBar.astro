---
import { BRAND_INFO, OUTLETS } from '../data/restaurantData';
---

<div class="relative z-20 w-full pt-3 sm:pt-8 pb-2 sm:pb-5">
  <!-- Mobile: Integrated Minimalist Precision Ribbon with Sleek Golden Corner Perimeter | Desktop: 4-Pillar Ultra-Clean Refined Cards -->
  <div
    id="hero-stats-container"
    class="grid grid-cols-4 sm:gap-2.5 lg:gap-3 w-full max-w-[370px] sm:max-w-[560px] bg-[#141414]/75 sm:bg-transparent backdrop-blur-md sm:backdrop-blur-none border border-[#E4A834]/40 sm:border-0 rounded-2xl sm:rounded-none divide-x divide-white/10 sm:divide-x-0 items-stretch shadow-[0_0_0_1px_rgba(228,168,52,0.15),inset_0_1px_0_0_rgba(228,168,52,0.35),0_4px_20px_rgba(0,0,0,0.5)] sm:shadow-none"
  >
    
    <!-- Card 1: 5 Outlets -->
    <a
      href="/outlets"
      class="py-2 px-1 sm:py-3 sm:px-2.5 lg:py-3.5 lg:px-3 flex flex-col justify-center items-center text-center sm:bg-white/[0.02] sm:hover:bg-white/[0.05] sm:backdrop-blur-sm sm:border sm:border-white/[0.07] sm:hover:border-[#E4A834]/50 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05)] sm:rounded-xl transition-all duration-200 group"
    >
      <span class="hidden sm:block text-[9px] sm:text-[10px] font-mono text-[#E4A834] uppercase tracking-[0.2em] font-bold mb-0.5">
        LOCATIONS
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-lg lg:text-xl font-bold uppercase text-[#E4A834] transition block leading-tight">
        <span data-counter="num" data-target="5" data-start="1" class="tabular-nums">5</span> <span class="text-[10px] xs:text-xs sm:text-xs lg:text-sm font-medium tracking-wide text-[#E4A834]/85">Outlets</span>
      </span>
    </a>

    <!-- Card 2: 4.5 Star Rating -->
    <div class="py-2 px-1 sm:py-3 sm:px-2.5 lg:py-3.5 lg:px-3 flex flex-col justify-center items-center text-center sm:bg-white/[0.02] sm:backdrop-blur-sm sm:border sm:border-white/[0.07] sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05)] sm:rounded-xl">
      <span class="hidden sm:block text-[9px] sm:text-[10px] font-mono text-[#E4A834] uppercase tracking-[0.2em] font-bold mb-0.5">
        RATING
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-lg lg:text-xl font-bold uppercase text-[#E4A834] flex items-center justify-center gap-1 leading-tight">
        <span data-counter="num" data-target="4.5" data-start="3.8" data-decimals="1" class="tabular-nums">4.5</span><svg class="w-2.5 h-2.5 xs:w-3 xs:h-3 sm:w-3.5 sm:h-3.5 text-[#E4A834] fill-[#E4A834] shrink-0 inline-block" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.6l2.9 6.2 6.6.7-4.9 4.5 1.4 6.5L12 17l-6 3.5 1.4-6.5L2.5 9.5l6.6-.7L12 2.6z" fill="#E4A834"/></svg><span class="hidden sm:inline text-xs lg:text-sm font-medium tracking-wide text-[#E4A834]/85"> Rating</span>
      </span>
    </div>

    <!-- Card 3: 100% Pure Veg -->
    <div class="py-2 px-1 sm:py-3 sm:px-2.5 lg:py-3.5 lg:px-3 flex flex-col justify-center items-center text-center sm:bg-white/[0.02] sm:backdrop-blur-sm sm:border sm:border-white/[0.07] sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05)] sm:rounded-xl">
      <span class="hidden sm:block text-[9px] sm:text-[10px] font-mono text-[#E4A834] uppercase tracking-[0.2em] font-bold mb-0.5">
        PURITY
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-lg lg:text-xl font-bold uppercase text-[#E4A834] block leading-tight">
        <span data-counter="num" data-target="100" data-start="75" class="tabular-nums">100</span>% <span class="text-[10px] xs:text-xs sm:text-xs lg:text-sm font-medium tracking-wide text-[#E4A834]/85">Veg</span>
      </span>
    </div>

    <!-- Card 4: Since 1980 -->
    <a
      href="/story"
      class="py-2 px-1 sm:py-3 sm:px-2.5 lg:py-3.5 lg:px-3 flex flex-col justify-center items-center text-center sm:bg-white/[0.02] sm:hover:bg-white/[0.05] sm:backdrop-blur-sm sm:border sm:border-white/[0.07] sm:hover:border-[#E4A834]/50 sm:shadow-[inset_0_1px_0_0_rgba(255,255,255,0.05)] sm:rounded-xl transition-all duration-200 group"
    >
      <span class="hidden sm:block text-[9px] sm:text-[10px] font-mono text-[#E4A834] uppercase tracking-[0.2em] font-bold mb-0.5">
        HERITAGE
      </span>
      <span class="font-display text-xs xs:text-sm sm:text-lg lg:text-xl font-bold uppercase text-[#E4A834] transition block leading-tight">
        <span class="text-[10px] xs:text-xs sm:text-xs lg:text-sm font-medium tracking-wide text-[#E4A834]/85">Est. </span><span data-counter="num" data-target="1980" data-start="1950" class="tabular-nums">1980</span>
      </span>
    </a>

  </div>
</div>

<script is:inline>
  function initStatsAnimation() {
    const container = document.getElementById('hero-stats-container');
    if (!container) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const counters = container.querySelectorAll('[data-counter="num"]');
    if (!counters.length) return;

    // Reduced motion: render final target values immediately
    if (reduceMotion) {
      counters.forEach((el) => {
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);
        el.textContent = decimals > 0 ? target.toFixed(decimals) : Math.round(target).toString();
      });
      return;
    }

    let hasRun = false;

    function runCounters() {
      if (hasRun) return;
      hasRun = true;

      // Silky-smooth Quintic Ease-Out (fast initial glide, ultra-soft gentle deceleration)
      const easeOutQuint = (t) => 1 - Math.pow(1 - t, 5);

      counters.forEach((el, index) => {
        const target = parseFloat(el.getAttribute('data-target') || '0');
        const start = parseFloat(el.getAttribute('data-start') || '0');
        const decimals = parseInt(el.getAttribute('data-decimals') || '0', 10);

        // Set baseline start immediately
        el.textContent = decimals > 0 ? start.toFixed(decimals) : Math.round(start).toString();

        // 60ms natural cascade stagger between cards
        const delay = index * 60;
        const duration = 1100 + index * 80; // 1100ms - 1340ms calibrated duration

        setTimeout(() => {
          let startTime = null;

          function frame(now) {
            if (!startTime) startTime = now;
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = easeOutQuint(progress);
            const currentVal = start + (target - start) * eased;

            el.textContent = decimals > 0 ? currentVal.toFixed(decimals) : Math.round(currentVal).toString();

            if (progress < 1) {
              requestAnimationFrame(frame);
            } else {
              // Lock into exact target
              el.textContent = decimals > 0 ? target.toFixed(decimals) : target.toString();

              // Micro-settle kinetic feedback: subtle tactile finish
              el.animate([
                { transform: 'scale(1.06)', opacity: 0.95 },
                { transform: 'scale(1)', opacity: 1 }
              ], { duration: 320, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' });
            }
          }

          requestAnimationFrame(frame);
        }, delay);
      });
    }

    // Coordinate with Welcome Entrance Screen
    if (document.documentElement.classList.contains('curtain-gate-active')) {
      // User is on welcome entrance: wait for curtains to part before counting!
      window.addEventListener('threshold:entered', () => {
        setTimeout(runCounters, 200);
      }, { once: true });
    } else {
      // Direct visitor or returning user: trigger when scrolled into view
      const observer = new IntersectionObserver((entries) => {
        if (entries[0] && entries[0].isIntersecting) {
          observer.disconnect();
          runCounters();
        }
      }, { threshold: 0.15 });
      observer.observe(container);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initStatsAnimation);
  } else {
    initStatsAnimation();
  }
  document.addEventListener('astro:page-load', initStatsAnimation);
</script>
