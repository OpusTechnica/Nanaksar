---
interface Props {
  mode?: 'page' | 'overlay';
}

const { mode = 'overlay' } = Astro.props;
---

<div
  id="nanaksar-threshold"
  class="threshold-root fixed inset-0 z-[99999] w-screen h-screen overflow-hidden select-none cursor-pointer bg-[#0A0A0A]"
  data-mode={mode}
  role="region"
  aria-label="Nanaksar Dhaba Royal Haveli Entrance"
  title="Click anywhere to open doors immediately"
>
  <script is:inline>
    if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('nanaksar_entered') === 'true' && window.location.pathname !== '/welcome') {
      const el = document.getElementById('nanaksar-threshold');
      if (el) el.remove();
      document.documentElement.classList.remove('curtain-gate-active');
    }
  </script>

  <!-- 1. LEFT HAVELI SHEESHAM DOOR LEAF (0% -> 50.3% with 3D Perspective Outward Swing) -->
  <div id="door-left" class="door-leaf door-leaf-left absolute top-0 left-0 w-[50.3%] h-full z-10 overflow-hidden">
    <!-- Handcrafted Sheesham Wood Vector Canvas -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 500 1000" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <!-- Aged Sheesham Timber Gradients -->
        <linearGradient id="sheesham-stiles-left" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#0E0906" />
          <stop offset="12%" stop-color="#1A120B" />
          <stop offset="35%" stop-color="#24190F" />
          <stop offset="50%" stop-color="#1D140D" />
          <stop offset="70%" stop-color="#261A11" />
          <stop offset="88%" stop-color="#160E08" />
          <stop offset="100%" stop-color="#0F0906" />
        </linearGradient>

        <linearGradient id="sheesham-panel-left" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#150E09" />
          <stop offset="25%" stop-color="#1E140D" />
          <stop offset="50%" stop-color="#18100A" />
          <stop offset="80%" stop-color="#22170F" />
          <stop offset="100%" stop-color="#120B07" />
        </linearGradient>

        <!-- Antique Brass Stud Radial (Gul-Mekh) -->
        <radialGradient id="brass-stud" cx="35%" cy="35%" r="65%">
          <stop offset="0%" stop-color="#FFF5D6" />
          <stop offset="25%" stop-color="#F5C862" />
          <stop offset="60%" stop-color="#C68A24" />
          <stop offset="85%" stop-color="#784E0F" />
          <stop offset="100%" stop-color="#3B2202" />
        </radialGradient>

        <!-- Forged Brass Ring Knocker Metallic Gradient -->
        <linearGradient id="brass-ring-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#6B4B18" />
          <stop offset="30%" stop-color="#E4A834" />
          <stop offset="50%" stop-color="#FFF0BE" />
          <stop offset="70%" stop-color="#B87B19" />
          <stop offset="100%" stop-color="#4A2F08" />
        </linearGradient>

        <!-- Cast Iron/Brass Corner Strap Gradient -->
        <linearGradient id="brass-strap" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#2C1D0B" />
          <stop offset="40%" stop-color="#8C5C18" />
          <stop offset="60%" stop-color="#D49929" />
          <stop offset="100%" stop-color="#362207" />
        </linearGradient>

        <!-- Carved Wood Inner Bevel Shadow Gradients -->
        <linearGradient id="bevel-top-shadow" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#000000" stop-opacity="0.92" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0" />
        </linearGradient>

        <linearGradient id="bevel-left-shadow" x1="0%" y1="0%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#000000" stop-opacity="0.88" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0" />
        </linearGradient>

        <linearGradient id="bevel-bottom-light" x1="0%" y1="100%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#E4A834" stop-opacity="0.18" />
          <stop offset="100%" stop-color="#E4A834" stop-opacity="0" />
        </linearGradient>

        <linearGradient id="bevel-right-shadow" x1="100%" y1="0%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#000000" stop-opacity="0.75" />
          <stop offset="100%" stop-color="#000000" stop-opacity="0" />
        </linearGradient>
      </defs>

      <!-- Foundation Wood Slab -->
      <rect width="500" height="1000" fill="url(#sheesham-stiles-left)" />

      <!-- Vertical Grain Overlay Stripes (Organic Handcrafted Timber Fibers) -->
      <g opacity="0.15">
        <line x1="18" y1="0" x2="18" y2="1000" stroke="#000" stroke-width="1.5" />
        <line x1="38" y1="0" x2="38" y2="1000" stroke="#FFF" stroke-width="0.75" />
        <line x1="140" y1="0" x2="140" y2="1000" stroke="#000" stroke-width="1.2" />
        <line x1="285" y1="0" x2="285" y2="1000" stroke="#000" stroke-width="1.5" />
        <line x1="390" y1="0" x2="390" y2="1000" stroke="#FFF" stroke-width="0.6" />
        <line x1="475" y1="0" x2="475" y2="1000" stroke="#000" stroke-width="2" />
      </g>

      <!-- 4 RECESSED COFFERED WOOD PANELS -->
      <!-- Panel 1 (Top) -->
      <g class="coffered-panel">
        <rect x="52" y="55" width="388" height="195" rx="5" fill="url(#sheesham-panel-left)" />
        <rect x="52" y="55" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="52" y="55" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="52" y="226" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="416" y="55" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <!-- Inner Raised Boss -->
        <polygon points="246,140 258,152 246,164 234,152" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="246" cy="152" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 2 (Upper-Mid) -->
      <g class="coffered-panel">
        <rect x="52" y="285" width="388" height="195" rx="5" fill="url(#sheesham-panel-left)" />
        <rect x="52" y="285" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="52" y="285" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="52" y="456" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="416" y="285" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="246,370 258,382 246,394 234,382" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="246" cy="382" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 3 (Lower-Mid) -->
      <g class="coffered-panel">
        <rect x="52" y="515" width="388" height="195" rx="5" fill="url(#sheesham-panel-left)" />
        <rect x="52" y="515" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="52" y="515" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="52" y="686" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="416" y="515" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="246,600 258,612 246,624 234,612" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="246" cy="612" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 4 (Bottom Kick) -->
      <g class="coffered-panel">
        <rect x="52" y="745" width="388" height="195" rx="5" fill="url(#sheesham-panel-left)" />
        <rect x="52" y="745" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="52" y="745" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="52" y="916" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="416" y="745" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="246,830 258,842 246,854 234,842" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="246" cy="842" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- HAND-HAMMERED ANTIQUE BRASS STUDS (GUL-MEKH) -->
      <!-- Vertical Center Meeting Stile Studs (x=468) -->
      <g class="brass-studs-meeting">
        <circle cx="468" cy="85" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="180" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="275" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="370" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="625" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="720" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="815" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="468" cy="910" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
      </g>

      <!-- Outer Hinge Stile Studs (x=26) -->
      <g class="brass-studs-hinge">
        <circle cx="26" cy="85" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="205" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="325" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="445" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="565" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="685" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="805" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="26" cy="925" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
      </g>

      <!-- Horizontal Divider Rail Studs -->
      <circle cx="160" cy="265" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="330" cy="265" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="160" cy="495" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="330" cy="495" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="160" cy="725" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="330" cy="725" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />

      <!-- FORGED BRASS & IRON RING KNOCKER (KUNDI - LEFT LEAF) -->
      <g class="door-knocker-left" filter="drop-shadow(0 8px 12px rgba(0,0,0,0.95))">
        <!-- Octagonal Star Escutcheon Backplate -->
        <polygon points="468,482 481,487 486,500 481,513 468,518 455,513 450,500 455,487" fill="url(#brass-stud)" stroke="#5E3809" stroke-width="2" />
        <circle cx="468" cy="500" r="9" fill="#1C120A" stroke="#C68A24" stroke-width="1.5" />
        <!-- Solid Cast Hanging Ring -->
        <path d="M 468 506 C 452 506, 440 520, 440 538 C 440 556, 452 570, 468 570 C 484 570, 496 556, 496 538 C 496 520, 484 506, 468 506 Z" fill="none" stroke="url(#brass-ring-grad)" stroke-width="7" stroke-linecap="round" />
        <!-- Anvil Striker Boss underneath -->
        <circle cx="468" cy="566" r="4.5" fill="url(#brass-stud)" />
      </g>

      <!-- CAST BRASS CORNER REINFORCEMENT STRAPS -->
      <!-- Top-Left Corner Bracket -->
      <path d="M 0 0 L 80 0 L 80 22 L 22 22 L 22 80 L 0 80 Z" fill="url(#brass-strap)" stroke="#1A1005" stroke-width="1.5" />
      <circle cx="50" cy="11" r="3.5" fill="url(#brass-stud)" />
      <circle cx="11" cy="50" r="3.5" fill="url(#brass-stud)" />
      <!-- Bottom-Left Corner Bracket -->
      <path d="M 0 1000 L 80 1000 L 80 978 L 22 978 L 22 920 L 0 920 Z" fill="url(#brass-strap)" stroke="#1A1005" stroke-width="1.5" />
      <circle cx="50" cy="989" r="3.5" fill="url(#brass-stud)" />
      <circle cx="11" cy="950" r="3.5" fill="url(#brass-stud)" />
    </svg>

    <!-- Warm Edge Shadow & Timber Vignette Overlay -->
    <div class="absolute inset-0 pointer-events-none door-timber-vignette" aria-hidden="true"></div>
    <!-- Meeting edge brass strike plate hairline -->
    <div class="absolute top-0 right-0 w-[2px] h-full bg-gradient-to-b from-[#7A4E12] via-[#E4A834] to-[#7A4E12] pointer-events-none shadow-[-2px_0_10px_rgba(0,0,0,0.95)]" aria-hidden="true"></div>
  </div>

  <!-- 2. RIGHT HAVELI SHEESHAM DOOR LEAF (50% -> 100% with Mirrored 3D Perspective Outward Swing) -->
  <div id="door-right" class="door-leaf door-leaf-right absolute top-0 right-0 w-[50.3%] h-full z-[9] overflow-hidden">
    <!-- Handcrafted Sheesham Wood Vector Canvas (Mirrored) -->
    <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 500 1000" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <!-- Mirrored Sheesham Timber Gradients -->
        <linearGradient id="sheesham-stiles-right" x1="100%" y1="0%" x2="0%" y2="0%">
          <stop offset="0%" stop-color="#0E0906" />
          <stop offset="12%" stop-color="#1A120B" />
          <stop offset="35%" stop-color="#24190F" />
          <stop offset="50%" stop-color="#1D140D" />
          <stop offset="70%" stop-color="#261A11" />
          <stop offset="88%" stop-color="#160E08" />
          <stop offset="100%" stop-color="#0F0906" />
        </linearGradient>

        <linearGradient id="sheesham-panel-right" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#150E09" />
          <stop offset="25%" stop-color="#1E140D" />
          <stop offset="50%" stop-color="#18100A" />
          <stop offset="80%" stop-color="#22170F" />
          <stop offset="100%" stop-color="#120B07" />
        </linearGradient>
      </defs>

      <!-- Foundation Wood Slab -->
      <rect width="500" height="1000" fill="url(#sheesham-stiles-right)" />

      <!-- Vertical Grain Overlay Stripes -->
      <g opacity="0.15">
        <line x1="25" y1="0" x2="25" y2="1000" stroke="#000" stroke-width="2" />
        <line x1="110" y1="0" x2="110" y2="1000" stroke="#FFF" stroke-width="0.6" />
        <line x1="215" y1="0" x2="215" y2="1000" stroke="#000" stroke-width="1.5" />
        <line x1="360" y1="0" x2="360" y2="1000" stroke="#000" stroke-width="1.2" />
        <line x1="462" y1="0" x2="462" y2="1000" stroke="#FFF" stroke-width="0.75" />
        <line x1="482" y1="0" x2="482" y2="1000" stroke="#000" stroke-width="1.5" />
      </g>

      <!-- 4 RECESSED COFFERED WOOD PANELS (RIGHT LEAF) -->
      <!-- Panel 1 (Top) -->
      <g class="coffered-panel">
        <rect x="60" y="55" width="388" height="195" rx="5" fill="url(#sheesham-panel-right)" />
        <rect x="60" y="55" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="60" y="55" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="60" y="226" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="424" y="55" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="254,140 266,152 254,164 242,152" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="254" cy="152" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 2 (Upper-Mid) -->
      <g class="coffered-panel">
        <rect x="60" y="285" width="388" height="195" rx="5" fill="url(#sheesham-panel-right)" />
        <rect x="60" y="285" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="60" y="285" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="60" y="456" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="424" y="285" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="254,370 266,382 254,394 242,382" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="254" cy="382" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 3 (Lower-Mid) -->
      <g class="coffered-panel">
        <rect x="60" y="515" width="388" height="195" rx="5" fill="url(#sheesham-panel-right)" />
        <rect x="60" y="515" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="60" y="515" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="60" y="686" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="424" y="515" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="254,600 266,612 254,624 242,612" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="254" cy="612" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- Panel 4 (Bottom Kick) -->
      <g class="coffered-panel">
        <rect x="60" y="745" width="388" height="195" rx="5" fill="url(#sheesham-panel-right)" />
        <rect x="60" y="745" width="388" height="24" fill="url(#bevel-top-shadow)" />
        <rect x="60" y="745" width="24" height="195" fill="url(#bevel-left-shadow)" />
        <rect x="60" y="916" width="388" height="24" fill="url(#bevel-bottom-light)" />
        <rect x="424" y="745" width="24" height="195" fill="url(#bevel-right-shadow)" />
        <polygon points="254,830 266,842 254,854 242,842" fill="#2A1C12" stroke="#120A05" stroke-width="1.5" />
        <circle cx="254" cy="842" r="5" fill="url(#brass-stud)" />
      </g>

      <!-- HAND-HAMMERED ANTIQUE BRASS STUDS (GUL-MEKH) -->
      <!-- Vertical Center Meeting Stile Studs (x=32) -->
      <g class="brass-studs-meeting">
        <circle cx="32" cy="85" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="180" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="275" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="370" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="625" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="720" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="815" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="32" cy="910" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
      </g>

      <!-- Outer Hinge Stile Studs (x=474) -->
      <g class="brass-studs-hinge">
        <circle cx="474" cy="85" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="205" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="325" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="445" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="565" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="685" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="805" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
        <circle cx="474" cy="925" r="7.5" fill="url(#brass-stud)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.85))" />
      </g>

      <!-- Horizontal Divider Rail Studs -->
      <circle cx="170" cy="265" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="340" cy="265" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="170" cy="495" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="340" cy="495" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="170" cy="725" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />
      <circle cx="340" cy="725" r="6" fill="url(#brass-stud)" filter="drop-shadow(0 2px 3px rgba(0,0,0,0.8))" />

      <!-- FORGED BRASS & IRON RING KNOCKER (KUNDI - RIGHT LEAF) -->
