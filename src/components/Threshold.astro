<style>
  /* ==========================================================================
     The Royal Haveli Teakwood Darwaza (शाही शीशम देवरी दरवाज़ा)
     Handcrafted Sheesham timber, coffered recessed panels, hammered brass studs
     ========================================================================== */

  .font-devanagari {
    font-family: 'Noto Serif Devanagari', 'Cinzel', serif;
  }

  .door-leaf {
    position: absolute;
    top: 0;
    width: 50.3%;
    height: 100%;
    z-index: 10;
    will-change: transform, box-shadow;
    background-color: #120C08;
  }

  /* Left Heavy Sheesham Door Leaf */
  .door-leaf-left {
    left: 0;
    transform-origin: left center;
    box-shadow: 25px 0 60px rgba(0, 0, 0, 0.98);
    transition: transform 1250ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 1250ms ease;
  }

  /* Right Heavy Sheesham Door Leaf */
  .door-leaf-right {
    right: 0;
    transform-origin: right center;
    box-shadow: -25px 0 60px rgba(0, 0, 0, 0.98);
    transition: transform 1250ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 1250ms ease;
  }

  /* 3D Perspective Outward Swing Kinematics */
  .threshold-root.is-opened .door-leaf-left {
    transform: perspective(1400px) rotateY(-82deg) scale(0.98);
    box-shadow: 5px 0 20px rgba(0, 0, 0, 0.5);
  }

  .threshold-root.is-opened .door-leaf-right {
    transform: perspective(1400px) rotateY(82deg) scale(0.98);
    box-shadow: -5px 0 20px rgba(0, 0, 0, 0.5);
  }

  /* Timber Vignette Overlay (Warm Tandoor Shadow Depth) */
  .door-timber-vignette {
    background: linear-gradient(
      to bottom,
      rgba(6, 4, 3, 0.94) 0%,
      rgba(18, 12, 8, 0.20) 18%,
      transparent 50%,
      rgba(14, 9, 6, 0.40) 82%,
      rgba(6, 4, 3, 0.96) 100%
    );
  }

  /* Center Seam Hearth Light Pulse */
  .door-light-pulse {
    animation: doorLightBreath 2.2s ease-in-out infinite;
  }

  @keyframes doorLightBreath {
    0%, 100% {
      opacity: 0.35;
      filter: drop-shadow(0 0 2px rgba(228, 168, 52, 0.4));
    }
    50% {
      opacity: 0.95;
      filter: drop-shadow(0 0 8px rgba(228, 168, 52, 0.85));
    }
  }

  .threshold-root.is-opened .door-center-light-seam {
    opacity: 0;
    transition: opacity 250ms ease;
  }

  /* --- REFINED METALLIC RUBY FOIL SHINE FOR 'स्वाद' AND 'प्यार' --- */
  .crimson-ruby-shine {
    background: linear-gradient(
      135deg,
      #B91C1C 0%,
      #E11D48 18%,
      #FFF5D6 46%, /* Pristine champagne-gold specular crest */
      #FF2A2A 68%,
      #991B1B 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.95));
    font-weight: 800;
    display: inline-block;
    animation: rubyFoilShimmer 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes rubyFoilShimmer {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: -100% 50%;
    }
  }

  /* Warm Makkhan Cream Text */
  .cream-text-warm {
    color: #F7F4EB;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    display: inline-block;
  }

  /* --- CRISP MEDALLION SETTLE --- */
  @keyframes medallionSettle {
    0% {
      opacity: 0;
      transform: scale(0.92);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .medallion-body {
    animation: medallionSettle 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  .medallion-rim-light {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 30deg,
      rgba(228, 168, 52, 0.55) 41deg,
      rgba(255, 240, 200, 0.95) 47deg,
      rgba(228, 168, 52, 0.55) 53deg,
      transparent 64deg,
      transparent 360deg
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 4px), #000 calc(100% - 3px));
  }

  .medallion-glint {
    width: 7px;
    height: 7px;
    transform: rotate(45deg);
    background: linear-gradient(135deg, #fff6dd 0%, #e4a834 55%, #965c00 100%);
    box-shadow: 0 0 6px rgba(228, 168, 52, 0.65);
    animation: glintBreath 4s ease-in-out 1.2s infinite;
  }

  @keyframes glintBreath {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* Synchronized Content Reveals */
  @keyframes sealReveal {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes textFadeIn {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ruleExpand {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .threshold-anim-seal {
    animation: sealReveal 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
  }

  .threshold-anim-eyebrow {
    animation: textFadeIn 450ms cubic-bezier(0.16, 1, 0.3, 1) 320ms both;
  }

  .threshold-anim-welcome {
    animation: textFadeIn 450ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
  }

  .threshold-anim-wordmark {
    animation: textFadeIn 500ms cubic-bezier(0.16, 1, 0.3, 1) 480ms both;
  }

  .threshold-anim-rule {
    transform-origin: center;
    animation: ruleExpand 500ms cubic-bezier(0.16, 1, 0.3, 1) 580ms both;
  }

  .threshold-anim-belief {
    animation: textFadeIn 500ms cubic-bezier(0.16, 1, 0.3, 1) 680ms both;
  }

  /* Center Medallion Release on Door Opening */
  .threshold-root.is-opened #curtain-center-stack {
    opacity: 0;
    transform: scale(1.08);
    pointer-events: none;
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .threshold-root.is-opened {
    pointer-events: none;
  }

  /* Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .door-leaf-left, .door-leaf-right {
      transition: none !important;
    }
    .medallion-body, .threshold-anim-seal, .threshold-anim-eyebrow, .threshold-anim-welcome, .threshold-anim-wordmark, .threshold-anim-rule, .threshold-anim-belief, .crimson-ruby-shine, .medallion-glint {
      animation: none !important;
    }
    .threshold-root.is-opened {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const startTime = performance.now();
    const thresholdEl = document.getElementById('nanaksar-threshold');
    if (!thresholdEl) return;

    // Analytics Sink
    function recordMetric(eventName, extra) {
      try {
        const key = 'nanaksar_threshold_analytics';
        const raw = localStorage.getItem(key);
        const data = raw ? JSON.parse(raw) : { shown: 0, entered: 0, autoEntered: 0, ctaTimes: [] };
        if (eventName === 'shown') data.shown = (data.shown || 0) + 1;
        if (eventName === 'entered') {
          data.entered = (data.entered || 0) + 1;
          if (extra && extra.timeMs) data.ctaTimes.push(Math.round(extra.timeMs));
        }
        if (eventName === 'auto_entered') {
          data.autoEntered = (data.autoEntered || 0) + 1;
        }
        data.lastUpdated = new Date().toISOString();
        localStorage.setItem(key, JSON.stringify(data));
      } catch (e) {}
    }

    // Skip check for session or ?skip=1
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('skip') === '1' || sessionStorage.getItem('nanaksar_entered') === 'true') {
      if (window.location.pathname !== '/welcome') {
        thresholdEl.style.display = 'none';
        thresholdEl.remove();
        document.body.classList.remove('overflow-hidden');
        document.documentElement.classList.remove('curtain-gate-active');
        return;
      }
    }

    // Lock body scroll while entrance ritual is actively running
    document.body.classList.add('overflow-hidden');
    recordMetric('shown', {});

    // --- DUAL-COLOR TYPEWRITER EFFECT WITH METALLIC SHINE ---
    // "स्वाद" and "प्यार" in Shining Metallic Ruby Crimson; remaining in Warm Cream
    const segments = [
      { text: '“घर जैसा ', isShine: false },
      { text: 'स्वाद', isShine: true },
      { text: ', सेवा वाला ', isShine: false },
      { text: 'प्यार', isShine: true },
      { text: '”', isShine: false }
    ];

    const typedContainer = document.getElementById('typed-container');
    const typedCursor = document.getElementById('typed-cursor');

    // Pre-decompose segments into grapheme units
    const decomposed = [];
    segments.forEach(function (seg) {
      let gList = [];
      try {
        if (typeof Intl !== 'undefined' && Intl.Segmenter) {
          const segger = new Intl.Segmenter('hi', { granularity: 'grapheme' });
          gList = Array.from(segger.segment(seg.text), function (s) { return s.segment; });
        } else {
          gList = Array.from(seg.text);
        }
      } catch (e) {
        gList = Array.from(seg.text);
      }
      decomposed.push({ isShine: seg.isShine, graphemes: gList });
    });

    let segIndex = 0;
    let charInSegIndex = 0;
    let currentSpan = null;
    let typeTimer = null;

    // Start typing after medallion settles (at 700ms)
    setTimeout(function () {
      if (!typedContainer) return;

      function typeNext() {
        if (segIndex >= decomposed.length) {
          // Finished: Fade out cursor softly
          setTimeout(function () {
            if (typedCursor) {
              typedCursor.style.transition = 'opacity 300ms ease';
              typedCursor.style.opacity = '0';
            }
          }, 350);
          return;
        }

        const curSeg = decomposed[segIndex];

        if (charInSegIndex === 0) {
          currentSpan = document.createElement('span');
          if (curSeg.isShine) {
            currentSpan.className = 'crimson-ruby-shine';
          } else {
            currentSpan.className = 'cream-text-warm';
          }
          typedContainer.appendChild(currentSpan);
        }

        if (charInSegIndex < curSeg.graphemes.length) {
          currentSpan.textContent += curSeg.graphemes[charInSegIndex];
          charInSegIndex++;
          typeTimer = setTimeout(typeNext, 45); // 45ms per grapheme
        } else {
          segIndex++;
          charInSegIndex = 0;
          typeNext();
        }
      }

      typeNext();
    }, 700);

    let hasOpened = false;

    function openDoors(type) {
      if (hasOpened) return;
      hasOpened = true;

      if (autoTimer) clearTimeout(autoTimer);
      if (typeTimer) clearTimeout(typeTimer);

      const elapsed = performance.now() - startTime;
      sessionStorage.setItem('nanaksar_entered', 'true');

      if (type === 'auto') {
        recordMetric('auto_entered', { timeMs: elapsed });
      } else {
        recordMetric('entered', { timeMs: elapsed });
      }

      // ROYAL 3D HAVELI DOOR SWING: Left & right leaves swing open outward
      thresholdEl.classList.add('is-opened');
      thresholdEl.classList.remove('bg-[#0A0A0A]');
      thresholdEl.classList.add('bg-transparent');
      document.documentElement.classList.remove('curtain-gate-active');
      window.dispatchEvent(new CustomEvent('threshold:entered', { detail: { type, elapsed } }));

      // Complete cleanup: Remove threshold completely after doors finish swing
      setTimeout(function () {
        thresholdEl.style.display = 'none';
        thresholdEl.remove();
        document.body.classList.remove('overflow-hidden');
        const mainContent = document.querySelector('main') || document.querySelector('#home');
        if (mainContent) {
          mainContent.setAttribute('tabindex', '-1');
          mainContent.focus();
        }
      }, 1150);
    }

    // AUTOMATIC LUXURY TIMING: 2.5 seconds total (as requested by user)
    const autoTimer = setTimeout(function () {
      openDoors('auto');
    }, 2500);

    // Clicking anywhere on the screen immediately opens the doors
    thresholdEl.addEventListener('click', function () {
      openDoors('tap');
    });

    // Keyboard support: Esc, Space, Enter
    window.addEventListener('keydown', function (e) {
      if (thresholdEl.style.display === 'none') return;
      if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter') {
        openDoors('key');
      }
    });
  })();
</script>
