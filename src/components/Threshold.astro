---
interface Props {
  mode?: 'page' | 'overlay';
}

const { mode = 'overlay' } = Astro.props;
---

<div
  id="nanaksar-threshold"
  class="threshold-root fixed inset-0 z-[99999] w-full h-full overflow-hidden select-none cursor-pointer bg-[#070707]"
  data-mode={mode}
  role="region"
  aria-label="Nanaksar Dhaba Welcome Entrance"
  title="Click anywhere to enter immediately"
>
  <script is:inline>
    if (typeof sessionStorage !== 'undefined' && sessionStorage.getItem('nanaksar_entered') === 'true' && window.location.pathname !== '/welcome') {
      const el = document.getElementById('nanaksar-threshold');
      if (el) el.remove();
      document.documentElement.classList.remove('curtain-gate-active');
    }
  </script>

  <!-- 1. LEFT POLISHED OBSIDIAN LEAF (0% -> 50.5%) -->
  <div id="obsidian-leaf-left" class="obsidian-leaf obsidian-leaf-left absolute top-0 left-0 w-[50.5%] h-full z-10 overflow-hidden"></div>

  <!-- 2. RIGHT POLISHED OBSIDIAN LEAF (50% -> 100%) -->
  <div id="obsidian-leaf-right" class="obsidian-leaf obsidian-leaf-right absolute top-0 right-0 w-[50.5%] h-full z-10 overflow-hidden"></div>

  <!-- 3. CENTERPIECE: MINIMALIST ROYAL TYPOGRAPHIC LOCKUP (Floating Pure Luxury) -->
  <div id="curtain-center-stack" class="absolute inset-0 z-20 flex items-center justify-center p-6 my-auto pointer-events-none">
    
    <div class="brand-lockup-body relative flex flex-col items-center justify-center text-center pointer-events-auto max-w-[320px] xs:max-w-[380px] sm:max-w-[480px] gap-2 sm:gap-2.5">
      
      <!-- 1. Heritage Seal: Crisp, authoritatively sized, perfectly centered -->
      <div class="threshold-anim-seal">
        <div class="relative p-1.5 rounded-full bg-[#121212] border border-[#E4A834]/40 shadow-[0_4px_16px_rgba(0,0,0,0.9)]">
          <img
            src="/assets/Logo.webp"
            alt="Nanaksar Dhaba Heritage Seal"
            width="280"
            height="280"
            class="w-16 h-16 xs:w-18 xs:h-18 sm:w-22 sm:h-22 object-contain select-none filter drop-shadow-[0_4px_12px_rgba(0,0,0,0.85)]"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

      <!-- 2. Eyebrow Timestamp: Desi Ghee Amber #E4A834 -->
      <div class="threshold-anim-eyebrow">
        <span class="font-mono text-[9px] xs:text-[10px] sm:text-[11px] text-[#E4A834] uppercase tracking-[0.3em] font-bold select-none drop-shadow">
          ESTD. 1980 — INDORE
        </span>
      </div>

      <!-- 3. Headline: "Welcome to" with gold hairline accents -->
      <div class="threshold-anim-welcome flex items-center gap-2.5 my-0.5">
        <span class="h-px w-4 sm:w-7 bg-gradient-to-r from-transparent to-[#E4A834]/70" aria-hidden="true"></span>
        <span class="font-serif text-[10px] xs:text-[11.5px] sm:text-[13px] text-[#F7F4EB]/90 uppercase tracking-[0.35em] font-medium select-none">
          Welcome to
        </span>
        <span class="h-px w-4 sm:w-7 bg-gradient-to-l from-transparent to-[#E4A834]/70" aria-hidden="true"></span>
      </div>

      <!-- 4. Wordmark: Brand_Name.webp -->
      <div class="threshold-anim-wordmark my-0.5">
        <img
          src="/assets/Brand_Name.webp"
          alt="Nanaksar Dhaba"
          width="480"
          height="120"
          class="w-42 xs:w-48 sm:w-56 h-auto object-contain select-none filter drop-shadow-[0_4px_14px_rgba(0,0,0,0.9)]"
          loading="eager"
          decoding="async"
        />
      </div>

      <!-- 5. Hairline Gold Rule: scaleX draw -->
      <div class="threshold-anim-rule h-px w-12 sm:w-16 bg-gradient-to-r from-transparent via-[#E4A834] to-transparent my-1"></div>

      <!-- 6. Dual-Color Hindi Quote: "स्वाद" and "प्यार" in Shining Ruby Foil, rest in Warm Cream -->
      <div class="threshold-anim-belief min-h-[32px] sm:min-h-[40px] flex items-center justify-center">
        <p
          id="threshold-hindi-quote"
          class="font-devanagari text-[14px] xs:text-[16px] sm:text-[19px] tracking-wide leading-normal select-none text-center whitespace-nowrap"
        >
          <span id="typed-container"></span><span id="typed-cursor" class="inline-block w-[2px] h-[1em] bg-[#E4A834] ml-0.5 align-middle animate-pulse"></span>
        </p>
      </div>

    </div>
  </div>
</div>

<style>
  /* ==========================================================================
     Pure Polished Obsidian Black Entrance
     Flawless piano lacquer black with zero distractions, channeling 100% focus
     into the central gold-rimmed medallion.
     ========================================================================== */

  .font-devanagari {
    font-family: 'Noto Serif Devanagari', 'Cinzel', serif;
  }

  .obsidian-leaf {
    position: absolute;
    top: 0;
    width: 50.5%;
    height: 100%;
    z-index: 10;
    will-change: transform;
    background-color: #070707;
  }

  /* Left Polished Obsidian Leaf */
  .obsidian-leaf-left {
    left: 0;
    background-color: #070707;
    transition: transform 1150ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: left center;
  }

  /* Right Polished Obsidian Leaf */
  .obsidian-leaf-right {
    right: 0;
    background-color: #070707;
    transition: transform 1150ms cubic-bezier(0.16, 1, 0.3, 1);
    transform-origin: right center;
  }

  /* Stately Silent Parting */
  .threshold-root.is-opened .obsidian-leaf-left {
    transform: translateX(-101%);
  }

  .threshold-root.is-opened .obsidian-leaf-right {
    transform: translateX(101%);
  }

  /* --- REFINED METALLIC RUBY FOIL SHINE FOR 'स्वाद' AND 'प्यार' --- */
  .crimson-ruby-shine {
    background: linear-gradient(
      135deg,
      #B91C1C 0%,
      #E11D48 18%,
      #FFF5D6 46%, /* Pristine champagne-gold specular crest */
      #FF2A2A 68%,
      #991B1B 100%
    );
    background-size: 220% 100%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 1px 2px rgba(0, 0, 0, 0.95));
    font-weight: 800;
    display: inline-block;
    animation: rubyFoilShimmer 2.8s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes rubyFoilShimmer {
    0% {
      background-position: 100% 50%;
    }
    100% {
      background-position: -100% 50%;
    }
  }

  /* Warm Makkhan Cream Text */
  .cream-text-warm {
    color: #F7F4EB;
    font-weight: 600;
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.9);
    display: inline-block;
  }

  /* --- CRISP BRAND LOCKUP SETTLE --- */
  @keyframes lockupSettle {
    0% {
      opacity: 0;
      transform: scale(0.96);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .brand-lockup-body {
    animation: lockupSettle 800ms cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  /* Synchronized Content Reveals */
  @keyframes sealReveal {
    0% {
      opacity: 0;
      transform: scale(0.85);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  @keyframes textFadeIn {
    0% {
      opacity: 0;
      transform: translateY(8px);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes ruleExpand {
    0% {
      opacity: 0;
      transform: scaleX(0);
    }
    100% {
      opacity: 1;
      transform: scaleX(1);
    }
  }

  .threshold-anim-seal {
    animation: sealReveal 600ms cubic-bezier(0.16, 1, 0.3, 1) 200ms both;
  }

  .threshold-anim-eyebrow {
    animation: textFadeIn 450ms cubic-bezier(0.16, 1, 0.3, 1) 320ms both;
  }

  .threshold-anim-welcome {
    animation: textFadeIn 450ms cubic-bezier(0.16, 1, 0.3, 1) 400ms both;
  }

  .threshold-anim-wordmark {
    animation: textFadeIn 500ms cubic-bezier(0.16, 1, 0.3, 1) 480ms both;
  }

  .threshold-anim-rule {
    transform-origin: center;
    animation: ruleExpand 500ms cubic-bezier(0.16, 1, 0.3, 1) 580ms both;
  }

  .threshold-anim-belief {
    animation: textFadeIn 500ms cubic-bezier(0.16, 1, 0.3, 1) 680ms both;
  }

  /* Medallion Scale and Dissolve on Opening */
  .threshold-root.is-opened #curtain-center-stack {
    opacity: 0;
    transform: scale(1.06);
    pointer-events: none;
    transition: opacity 350ms ease, transform 450ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .threshold-root.is-opened {
    pointer-events: none;
  }

  /* Prefers Reduced Motion */
  @media (prefers-reduced-motion: reduce) {
    .obsidian-leaf-left, .obsidian-leaf-right {
      transition: none !important;
    }
    .brand-lockup-body, .threshold-anim-seal, .threshold-anim-eyebrow, .threshold-anim-welcome, .threshold-anim-wordmark, .threshold-anim-rule, .threshold-anim-belief, .crimson-ruby-shine {
      animation: none !important;
    }
    .threshold-root.is-opened {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (function () {
    const startTime = performance.now();
    const thresholdEl = document.getElementById('nanaksar-threshold');
    if (!thresholdEl) return;

    // Analytics Sink
    function recordMetric(eventName, extra) {
      try {
        const key = 'nanaksar_threshold_analytics';
        const raw = localStorage.getItem(key);
        const data = raw ? JSON.parse(raw) : { shown: 0, entered: 0, autoEntered: 0, ctaTimes: [] };
        if (eventName === 'shown') data.shown = (data.shown || 0) + 1;
        if (eventName === 'entered') {
          data.entered = (data.entered || 0) + 1;
          if (extra && extra.timeMs) data.ctaTimes.push(Math.round(extra.timeMs));
        }
        if (eventName === 'auto_entered') {
          data.autoEntered = (data.autoEntered || 0) + 1;
        }
        data.lastUpdated = new Date().toISOString();
        localStorage.setItem(key, JSON.stringify(data));
      } catch (e) {}
    }

    // Skip check for session or ?skip=1
    const urlParams = new URLSearchParams(window.location.search);
    if (urlParams.get('skip') === '1' || sessionStorage.getItem('nanaksar_entered') === 'true') {
      if (window.location.pathname !== '/welcome') {
        thresholdEl.style.display = 'none';
        thresholdEl.remove();
        document.body.classList.remove('overflow-hidden');
        document.documentElement.classList.remove('curtain-gate-active');
        return;
      }
    }

    // Lock body scroll while entrance ritual is actively running
    document.body.classList.add('overflow-hidden');
    recordMetric('shown', {});

    // --- DUAL-COLOR TYPEWRITER EFFECT WITH METALLIC SHINE ---
    // "स्वाद" and "प्यार" in Shining Metallic Ruby Crimson; remaining in Warm Cream
    const segments = [
      { text: '“घर जैसा ', isShine: false },
      { text: 'स्वाद', isShine: true },
      { text: ', सेवा वाला ', isShine: false },
      { text: 'प्यार', isShine: true },
      { text: '”', isShine: false }
    ];

    const typedContainer = document.getElementById('typed-container');
    const typedCursor = document.getElementById('typed-cursor');

    // Pre-decompose segments into grapheme units
    const decomposed = [];
    segments.forEach(function (seg) {
      let gList = [];
      try {
        if (typeof Intl !== 'undefined' && Intl.Segmenter) {
          const segger = new Intl.Segmenter('hi', { granularity: 'grapheme' });
          gList = Array.from(segger.segment(seg.text), function (s) { return s.segment; });
        } else {
          gList = Array.from(seg.text);
        }
      } catch (e) {
        gList = Array.from(seg.text);
      }
      decomposed.push({ isShine: seg.isShine, graphemes: gList });
    });

    let segIndex = 0;
    let charInSegIndex = 0;
    let currentSpan = null;
    let typeTimer = null;

    // Start typing after medallion settles (at 700ms)
    setTimeout(function () {
      if (!typedContainer) return;

      function typeNext() {
        if (segIndex >= decomposed.length) {
          // Finished: Fade out cursor softly
          setTimeout(function () {
            if (typedCursor) {
              typedCursor.style.transition = 'opacity 300ms ease';
              typedCursor.style.opacity = '0';
            }
          }, 350);
          return;
        }

        const curSeg = decomposed[segIndex];

        if (charInSegIndex === 0) {
          currentSpan = document.createElement('span');
          if (curSeg.isShine) {
            currentSpan.className = 'crimson-ruby-shine';
          } else {
            currentSpan.className = 'cream-text-warm';
          }
          typedContainer.appendChild(currentSpan);
        }

        if (charInSegIndex < curSeg.graphemes.length) {
          currentSpan.textContent += curSeg.graphemes[charInSegIndex];
          charInSegIndex++;
          typeTimer = setTimeout(typeNext, 45); // 45ms per grapheme
        } else {
          segIndex++;
          charInSegIndex = 0;
          typeNext();
        }
      }

      typeNext();
    }, 700);

    let hasOpened = false;

    function openEntrance(type) {
      if (hasOpened) return;
      hasOpened = true;

      if (autoTimer) clearTimeout(autoTimer);
      if (typeTimer) clearTimeout(typeTimer);

      const elapsed = performance.now() - startTime;
      sessionStorage.setItem('nanaksar_entered', 'true');

      if (type === 'auto') {
        recordMetric('auto_entered', { timeMs: elapsed });
      } else {
        recordMetric('entered', { timeMs: elapsed });
      }

      // STATELY SILENT PARTING: Left & right obsidian leaves glide open
      thresholdEl.classList.add('is-opened');
      thresholdEl.classList.remove('bg-[#070707]');
      thresholdEl.classList.add('bg-transparent');
      document.documentElement.classList.remove('curtain-gate-active');
      window.dispatchEvent(new CustomEvent('threshold:entered', { detail: { type, elapsed } }));

      // Complete cleanup: Remove threshold completely after leaves part
      setTimeout(function () {
        thresholdEl.style.display = 'none';
        thresholdEl.remove();
        document.body.classList.remove('overflow-hidden');
        const mainContent = document.querySelector('main') || document.querySelector('#home');
        if (mainContent) {
          mainContent.setAttribute('tabindex', '-1');
          mainContent.focus();
        }
      }, 1150);
    }

    // AUTOMATIC LUXURY TIMING: 2.5 seconds total (as requested by user)
    const autoTimer = setTimeout(function () {
      openEntrance('auto');
    }, 2500);

    // Clicking anywhere on the screen immediately enters
    thresholdEl.addEventListener('click', function () {
      openEntrance('tap');
    });

    // Keyboard support: Esc, Space, Enter
    window.addEventListener('keydown', function (e) {
      if (thresholdEl.style.display === 'none') return;
      if (e.key === 'Escape' || e.key === ' ' || e.key === 'Enter') {
        openEntrance('key');
      }
    });
  })();
</script>
